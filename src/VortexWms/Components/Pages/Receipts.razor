@page "/recepciones"
@inherits WmsPage

<SectionContent SectionName="page-title">@T("receipts.recepciones_2")</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("receipts.recepcion_de_mercaderia")</h2>
            <p>@T("receipts.las_ordenes_de_compra_del")</p>
        </div>
    </div>

    <div class="filters">
        <div class="field search">
            <label>@T("receipts.buscar")</label>
            <div class="input-icon">
                <Icon Name="search" Size="16" />
                <input class="control" placeholder="@(T("receipts.proveedor"))" value="@_search" @oninput="OnSearchInput" />
            </div>
        </div>
        <div class="field" style="width:auto">
            <label>@T("receipts.estado")</label>
            <div class="segmented">
                @foreach (var (value, label) in Tabs)
                {
                    <button class="@(_status == value ? "on" : "")" @onclick="() => SetStatusAsync(value)">@label</button>
                }
            </div>
        </div>
        <div class="actions">
            <button class="btn btn-dark" disabled="@(!Session.Can(WmsPermissions.Receive))" @onclick="OpenDirect"><Icon Name="plus" Size="18" />@T("receipts.nueva_recepcion")</button>
        </div>
    </div>

    @if (_result is { } page)
    {
        @if (page.Total == 0 && !Loading)
        {
            <EmptyState Icon="inbox" Title="@(_status == ReceiptStatuses.Expected ? T("receipts.no_hay_recepciones_por_recibir") : T("receipts.no_hay_recepciones"))"
                        Text="@(T("receipts.cuando_el_erp_emita_una"))" />
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr>
                            <th>@T("receipts.recepcion")</th>
                            <th>@T("receipts.proveedor_2")</th>
                            <th>@T("receipts.sede")</th>
                            <th class="num">@T("receipts.unidades")</th>
                            <th>@T("receipts.fecha")</th>
                            <th>@T("receipts.estado")</th>
                            <th class="actions-col">@T("receipts.acciones")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in page.Items)
                        {
                            var (text, tone) = StatusPill.ForReceipt(r.Status);
                            <tr @key="r.Id">
                                <td>
                                    <div class="cell-main">
                                        <div class="stat-icon" style="width:34px;height:34px;border-radius:10px"><Icon Name="inbox" Size="16" /></div>
                                        <div class="two-line"><span class="t1">@r.Number</span><span class="t2">@(r.PurchaseOrderId is null ? T("receipts.entrada_directa") : T("receipts.orden_de_compra_del_erp"))</span></div>
                                    </div>
                                </td>
                                <td><span class="@(r.SupplierName is null ? "faint" : "")">@(r.SupplierName ?? T("receipts.sin_proveedor"))</span></td>
                                <td><span class="muted">@r.SiteName</span></td>
                                <td class="num">
                                    <div class="two-line" style="align-items:flex-end">
                                        <span class="t1">@Fmt.Qty(r.Status == ReceiptStatuses.Received ? r.ReceivedUnits : r.ExpectedUnits)</span>
                                        <span class="t2">@r.LineCount @(r.LineCount == 1 ? T("receipts.articulo") : T("receipts.articulos"))</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="two-line">
                                        <span class="t1">@Fmt.Date(r.ReceivedAt ?? r.CreatedAt)</span>
                                        <span class="t2">@(r.ReceivedAt is null ? T("receipts.emitida") : T("receipts.recibida")) @Fmt.Ago(r.ReceivedAt ?? r.CreatedAt)</span>
                                    </div>
                                </td>
                                <td><StatusPill Text="@text" Tone="@tone" /></td>
                                <td class="actions-col">
                                    <KebabMenu>
                                        @if (r.Status == ReceiptStatuses.Expected)
                                        {
                                            <button disabled="@(!Session.Can(WmsPermissions.Receive))" @onclick="() => OpenReceive(r)"><Icon Name="package-check" Size="18" />@T("receipts.recibir_2")</button>
                                        }
                                        <button @onclick="() => OpenDetail(r)"><Icon Name="eye" Size="18" />@T("receipts.ver_detalle")</button>
                                        @if (r.Status == ReceiptStatuses.Expected)
                                        {
                                            <hr />
                                            <button class="danger" disabled="@(!Session.Can(WmsPermissions.CancelReceipt))" @onclick="() => _cancel = r"><Icon Name="ban" Size="18" />@T("receipts.anular")</button>
                                        }
                                    </KebabMenu>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Page="page.Page" PageSize="page.PageSize" Total="page.Total" Noun="@(T("receipts.recepciones"))" OnPage="async p => { _page = p; await ReloadAsync(); }" />
        }
    }
</div>

@if (_direct is { } d)
{
    <Modal Title="@(T("receipts.nueva_recepcion"))" Subtitle="@(T("receipts.entrada_de_mercaderia_sin_orden"))" Size="lg" Error="@_error" OnClose="Close">
        <ChildContent>
            <div class="form-row">
                <div class="field">
                    <label>@T("receipts.sede_que_recibe")</label>
                    <select class="select" value="@d.SiteId" @onchange="e => d.SiteId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null">
                        <option value="">@T("receipts.elige_la_sede")</option>
                        @foreach (var site in _sites)
                        {
                            <option value="@site.Id">@site.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>@T("receipts.proveedor_opcional")</label>
                    <select class="select" value="@d.SupplierId" @onchange="e => d.SupplierId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null">
                        <option value="">@T("receipts.sin_proveedor")</option>
                        @foreach (var supplier in _suppliers)
                        {
                            <option value="@supplier.Id">@supplier.Label@(supplier.Detail is null ? "" : $" · {supplier.Detail}")</option>
                        }
                    </select>
                </div>
            </div>
            <LineEditor Changed="StateHasChanged" Lines="d.Lines" ShowPrice PriceLabel="@(T("receipts.costo_unit"))" />
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="Close">@T("receipts.cancelar")</button>
            <button class="btn btn-dark" disabled="@(_busy || d.Lines.Count == 0)" @onclick="SaveDirectAsync">@T("receipts.registrar_recepcion")</button>
        </Footer>
    </Modal>
}

@if (_receive is { } rc)
{
    <Modal Title="@(T("receipts.recibir", rc.Receipt.Number))" Subtitle="@(T("receipts.subtitulo_recibir", rc.Receipt.SupplierName ?? T("receipts.sin_proveedor_nombre"), rc.Receipt.SiteName))"
           Size="lg" Error="@_error" OnClose="Close">
        <ChildContent>
            <div class="lines">
                <div class="line" style="background:transparent;padding-top:0;padding-bottom:0">
                    <span class="field-label">@T("receipts.articulo_2")</span>
                    <span class="field-label">@T("receipts.recibido")</span>
                    <span></span>
                </div>
                @foreach (var line in rc.Lines)
                {
                    <div class="line" @key="line.Row.LineNo">
                        <div class="cell-main">
                            <Avatar Text="@line.Row.ItemName" Size="34" />
                            <div class="two-line">
                                <span class="t1">@line.Row.ItemName</span>
                                <span class="t2">@T("receipts.esperado", line.Row.Sku, Fmt.Qty(line.Row.ExpectedQty))
                                    @if (line.Received != line.Row.ExpectedQty)
                                    {
                                        <span class="warn-text"> @T("receipts.diferencia", (line.Received > line.Row.ExpectedQty ? "+" : ""), (Fmt.Qty(line.Received - line.Row.ExpectedQty)))</span>
                                    }
                                </span>
                            </div>
                        </div>
                        <input class="control" type="number" min="0" step="any" @bind="line.Received" @bind:event="oninput" aria-label="@(T("receipts.cantidad_recibida"))" />
                        <button class="btn btn-ghost icon-btn sm" title="@(T("receipts.igual_lo_esperado"))" aria-label="@(T("receipts.igual_lo_esperado"))" @onclick="() => line.Received = line.Row.ExpectedQty"><Icon Name="check" Size="16" /></button>
                    </div>
                }
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="Close">@T("receipts.cancelar")</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="SaveReceiveAsync">@T("receipts.confirmar_recepcion")</button>
        </Footer>
    </Modal>
}

@if (_detail is { } dt)
{
    <Modal Title="@dt.Receipt.Number" Subtitle="@($"{dt.Receipt.SupplierName ?? "Sin proveedor"} · {dt.Receipt.SiteName}")" Size="lg" OnClose="Close">
        <ChildContent>
            <div class="table-wrap">
                <table class="data" style="min-width:520px">
                    <thead>
                        <tr><th>@T("receipts.articulo_2")</th><th class="num">@T("receipts.esperado_2")</th><th class="num">@T("receipts.recibido")</th><th class="num">@T("receipts.costo_unit")</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var l in dt.Lines)
                        {
                            <tr>
                                <td><div class="two-line"><span class="t1">@l.ItemName</span><span class="t2">#@l.Sku</span></div></td>
                                <td class="num">@Fmt.Qty(l.ExpectedQty)</td>
                                <td class="num strong">@Fmt.Qty(l.ReceivedQty)</td>
                                <td class="num">@(l.UnitCost is { } cost ? cost.ToString("#,0.00", Fmt.Culture) : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="Close">@T("receipts.cerrar")</button>
        </Footer>
    </Modal>
}

@if (_cancel is { } cancel)
{
    <Modal Title="@(T("receipts.anular_la_recepcion"))" Subtitle="@(T("receipts.dejara_de_estar_por_recibir", cancel.Number))" OnClose="Close">
        <Footer>
            <button class="btn" @onclick="Close">@T("receipts.volver")</button>
            <button class="btn btn-danger" disabled="@_busy" @onclick="CancelAsync">@T("receipts.anular_recepcion")</button>
        </Footer>
    </Modal>
}

@code {
    private sealed class DirectForm
    {
        public Guid? SiteId { get; set; }
        public Guid? SupplierId { get; set; }
        public List<LineEditor.LineDraft> Lines { get; } = [];
    }

    private sealed class ReceiveLine(ReceiptLineRow row)
    {
        public ReceiptLineRow Row { get; } = row;
        public decimal Received { get; set; } = row.ExpectedQty;
    }

    private sealed record ReceiveForm(ReceiptRow Receipt, List<ReceiveLine> Lines);
    private sealed record DetailView(ReceiptRow Receipt, IReadOnlyList<ReceiptLineRow> Lines);

    private static readonly (string Value, string Label)[] Tabs =
    [
        (ReceiptStatuses.Expected, T("receipts.por_recibir")), (ReceiptStatuses.Received, T("receipts.recibidas")), (ReceiptStatuses.Cancelled, T("receipts.anuladas")), ("", T("receipts.todas")),
    ];

    [SupplyParameterFromQuery(Name = "nueva")] public int? NewQuery { get; set; }

    private const int PageSize = 10;
    private PagedResult<ReceiptRow>? _result;
    private IReadOnlyList<SiteRow> _sites = [];
    private IReadOnlyList<Option> _suppliers = [];
    private string _search = "", _status = ReceiptStatuses.Expected;
    private int _page = 1;
    private bool _statusChosen;
    private CancellationTokenSource? _debounce;

    private DirectForm? _direct;
    private ReceiveForm? _receive;
    private DetailView? _detail;
    private ReceiptRow? _cancel;
    private string? _error;
    private bool _busy;

    protected override async Task LoadAsync()
    {
        _sites = await Wms.Master.GetSitesAsync(activeOnly: true, mineOnly: true);
        _suppliers = await Wms.Master.GetPartyOptionsAsync(suppliers: true);
        _result = await Wms.Receipts.GetReceiptsAsync(_search, _status, _page, PageSize);
        // Sin nada por recibir, mostrar todas para que la pantalla no parezca vacía.
        if (!_statusChosen && _result.Total == 0 && _search == "")
        {
            _statusChosen = true;
            _status = "";
            _result = await Wms.Receipts.GetReceiptsAsync(_search, _status, _page, PageSize);
        }
        if (_result.Items.Count == 0 && _page > 1)
        {
            _page = _result.Pages;
            _result = await Wms.Receipts.GetReceiptsAsync(_search, _status, _page, PageSize);
        }
    }

    protected override void OnParametersSet()
    {
        if (NewQuery == 1 && _direct is null)
            OpenDirect();
    }

    private async Task SetStatusAsync(string status)
    {
        _statusChosen = true;
        _status = status;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(220, _debounce.Token);
            _page = 1;
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void OpenDirect()
    {
        _error = null;
        _direct = new DirectForm { SiteId = Session.DefaultSiteId ?? _sites.FirstOrDefault()?.Id };
    }

    private async Task SaveDirectAsync()
    {
        if (_direct is not { } d)
            return;
        if (d.SiteId is not { } site)
        {
            _error = T("receipts.elige_la_sede_que_recibe");
            return;
        }
        if (d.Lines.Any(l => l.Price is not >= 0))
        {
            // El costo de entrada valoriza el inventario (costo promedio): en un ingreso directo es obligatorio.
            _error = T("receipts.indica_el_costo_unitario");
            return;
        }
        _busy = true;
        string? number = null;
        _error = await TryAsync(async () => number = await Wms.Receipts.ReceiveDirectAsync(site, d.SupplierId, d.Lines.Select(l => l.ToDocumentLine()).ToList()));
        _busy = false;
        if (_error is null)
        {
            Toasts.Success(T("receipts.recepcion_registrada_el_stock_ya", number));
            Close();
        }
    }

    private async Task OpenReceive(ReceiptRow receipt)
    {
        _error = null;
        var lines = await Wms.Receipts.GetLinesAsync(receipt.Id);
        _receive = new ReceiveForm(receipt, lines.Select(l => new ReceiveLine(l)).ToList());
    }

    private async Task SaveReceiveAsync()
    {
        if (_receive is not { } rc)
            return;
        _busy = true;
        _error = await TryAsync(() => Wms.Receipts.ReceiveExpectedAsync(rc.Receipt.Id, rc.Lines.ToDictionary(l => l.Row.LineNo, l => l.Received)),
            T("receipts.recibida_el_stock_ya_esta", rc.Receipt.Number));
        _busy = false;
        if (_error is null)
            Close();
    }

    private async Task OpenDetail(ReceiptRow receipt) =>
        _detail = new DetailView(receipt, await Wms.Receipts.GetLinesAsync(receipt.Id));

    private async Task CancelAsync()
    {
        if (_cancel is not { } receipt)
            return;
        _busy = true;
        await RunAsync(() => Wms.Receipts.CancelAsync(receipt.Id), T("receipts.anulada", receipt.Number));
        _busy = false;
        Close();
    }

    private void Close()
    {
        _direct = null;
        _receive = null;
        _detail = null;
        _cancel = null;
        _error = null;
        if (NewQuery == 1)
            Nav.NavigateTo("recepciones", replace: true);
    }

    public override void Dispose()
    {
        _debounce?.Cancel();
        base.Dispose();
    }
}
