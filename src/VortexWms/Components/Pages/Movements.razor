@page "/movimientos"
@inherits WmsPage

<SectionContent SectionName="page-title">@T("movements.movimientos_2")</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("movements.kardex")</h2>
            <p>@T("movements.cada_entrada_salida_queda_registrada")</p>
        </div>
    </div>

    <div class="filters">
        <div class="field search">
            <label>@T("movements.buscar")</label>
            <div class="input-icon">
                <Icon Name="search" Size="16" />
                <input class="control" placeholder="@(T("movements.sku_documento"))" value="@_search" @oninput="OnSearchInput" />
            </div>
        </div>
        <div class="field">
            <label>@T("movements.sede")</label>
            <select class="select" value="@_site" @onchange="async e => { _site = e.Value?.ToString() ?? string.Empty; _page = 1; await ReloadAsync(); }">
                <option value="">@T("movements.todas")</option>
                @foreach (var site in _sites)
                {
                    <option value="@site.Id">@site.Name</option>
                }
            </select>
        </div>
        <div class="field">
            <label>@T("movements.desde")</label>
            <input class="control" type="date" value="@_from?.ToString("yyyy-MM-dd")" @onchange="async e => { _from = ParseDate(e.Value); _page = 1; await ReloadAsync(); }" />
        </div>
        <div class="field">
            <label>@T("movements.hasta")</label>
            <input class="control" type="date" value="@_to?.ToString("yyyy-MM-dd")" @onchange="async e => { _to = ParseDate(e.Value); _page = 1; await ReloadAsync(); }" />
        </div>
        <div class="field">
            <label>@T("movements.tipo")</label>
            <select class="select" value="@_kind" @onchange="async e => { _kind = e.Value?.ToString() ?? string.Empty; _page = 1; await ReloadAsync(); }">
                <option value="">@T("movements.todos")</option>
                @foreach (var kind in MovementKinds.All)
                {
                    <option value="@kind">@Fmt.MovementKind(kind)</option>
                }
            </select>
        </div>
    </div>

    @if (_result is { } page)
    {
        @if (page.Total == 0 && !Loading)
        {
            <EmptyState Icon="arrows" Title="@(T("movements.sin_movimientos"))" Text="@(_search != "" || _site != "" || _kind != "" || _from is not null || _to is not null ? T("movements.nada_coincide_con_los_filtros") : T("movements.aun_no_hay_entradas_ni"))" />
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr>
                            <th>@T("movements.fecha")</th>
                            <th>@T("movements.articulo")</th>
                            <th>@T("movements.movimiento")</th>
                            <th>@T("movements.sede")</th>
                            <th class="num">@T("movements.cantidad")</th>
                            <th class="num">@T("movements.saldo")</th>
                            @if (_costs)
                            {
                                <th class="num">@T("movements.costo_unit")</th>
                                <th class="num">@T("movements.costo_total")</th>
                                <th class="num">@T("movements.saldo_valorizado")</th>
                            }
                            <th>@T("movements.usuario")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in page.Items)
                        {
                            <tr @key="m.Id">
                                <td>
                                    <div class="two-line">
                                        <span class="t1">@Fmt.Date(m.OccurredAt)</span>
                                        <span class="t2">@m.OccurredAt.ToLocalTime().ToString("HH:mm", Fmt.Culture)</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="cell-main">
                                        <Avatar Text="@m.ItemName" Size="32" />
                                        <div class="two-line"><span class="t1">@m.ItemName</span><span class="t2">#@m.Sku</span></div>
                                    </div>
                                </td>
                                <td>
                                    <div class="two-line">
                                        <span class="t1" style="font-weight:600">@Fmt.MovementKind(m.Kind)</span>
                                        <span class="t2">@Detail(m)</span>
                                    </div>
                                </td>
                                <td><span class="muted">@m.SiteName</span></td>
                                <td class="num"><span class="@(m.Quantity >= 0 ? "qty-pos" : "qty-neg")">@(m.Quantity > 0 ? "+" : "")@Fmt.Qty(m.Quantity)</span></td>
                                <td class="num strong">@Fmt.Qty(m.OnHandAfter)</td>
                                @if (_costs)
                                {
                                    <td class="num">@(m.UnitCost is { } unit ? Fmt.Money(unit, _currency) : "—")</td>
                                    <td class="num">@(m.TotalCost is { } total ? Fmt.Money(total, _currency) : "—")</td>
                                    <td class="num strong">@(m.ValueAfter is { } value ? Fmt.Money(value, _currency) : "—")</td>
                                }
                                <td>
                                    <div class="two-line">
                                        <span class="t1" style="font-weight:600">@(m.UserName ?? "—")</span>
                                        @if (m.Note is not null)
                                        {
                                            <span class="t2" title="@m.Note">@m.Note</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Page="page.Page" PageSize="page.PageSize" Total="page.Total" Noun="@(T("movements.movimientos"))" OnPage="async p => { _page = p; await ReloadAsync(); }" />
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    private const int PageSize = 15;
    private PagedResult<MovementRow>? _result;
    private IReadOnlyList<SiteRow> _sites = [];
    private string _search = "", _site = "", _kind = "";
    private string? _appliedQuery;
    private bool _queryApplied;
    private int _page = 1;
    private CancellationTokenSource? _debounce;

    protected override void OnInitialized() => ApplyQuery();

    protected override async Task OnParametersSetAsync()
    {
        if (ApplyQuery())
            await ReloadAsync();
    }

    private bool ApplyQuery()
    {
        if (_queryApplied && Query == _appliedQuery)
            return false;
        (_queryApplied, _appliedQuery, _search, _page) = (true, Query, Query ?? "", 1);
        return true;
    }

    protected override async Task LoadAsync()
    {
        _sites = await Wms.Master.GetSitesAsync(mineOnly: true);
        _costs = Session.Can(WmsPermissions.ViewCosts);
        _currency = (await Wms.Master.GetCompanyAsync())?.CurrencyCode ?? "PEN";
        var query = new MovementQuery(_search, Guid.TryParse(_site, out var site) ? site : null, _kind == "" ? null : _kind, _page, PageSize,
            From: _from is { } from ? CompanyMidnight(from) : null, To: _to is { } to ? CompanyMidnight(to.AddDays(1)) : null);
        _result = await Wms.Inventory.GetMovementsAsync(query);
        if (_result.Items.Count == 0 && _page > 1)
        {
            _page = _result.Pages;
            _result = await Wms.Inventory.GetMovementsAsync(query with { Page = _page });
        }
    }

    private bool _costs;
    private string _currency = "PEN";
    private DateOnly? _from;
    private DateOnly? _to;

    private static DateOnly? ParseDate(object? value) => DateOnly.TryParse(value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : null;

    /// <summary>Medianoche del día en la hora de la empresa (el kardex se filtra por días de la empresa).</summary>
    private static DateTimeOffset CompanyMidnight(DateOnly day)
    {
        var local = day.ToDateTime(TimeOnly.MinValue);
        try
        {
            var zone = Fmt.TimeZone is { } id ? TimeZoneInfo.FindSystemTimeZoneById(id) : TimeZoneInfo.Local;
            return new DateTimeOffset(local, zone.GetUtcOffset(local));
        }
        catch (TimeZoneNotFoundException)
        {
            return new DateTimeOffset(local, TimeZoneInfo.Local.GetUtcOffset(local));
        }
    }

    private static string Detail(MovementRow m) => string.Join(" · ", new[]
    {
        m.Kind == MovementKinds.Adjustment ? Fmt.Reason(m.Reason) : null,
        m.Reference,
    }.Where(s => !string.IsNullOrEmpty(s)));

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(220, _debounce.Token);
            _page = 1;
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    public override void Dispose()
    {
        _debounce?.Cancel();
        base.Dispose();
    }
}
