@page "/articulos"
@inherits WmsPage

<SectionContent SectionName="page-title">@T("items.articulos_2")</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("items.catalogo_de_articulos")</h2>
            <p>@T("items.es_el_mismo_catalogo_del")</p>
        </div>
    </div>

    <div class="filters">
        <div class="field search">
            <label>@T("items.buscar")</label>
            <div class="input-icon">
                <Icon Name="search" Size="16" />
                <input class="control" placeholder="@(T("items.nombre_sku"))" value="@_search" @oninput="OnSearchInput" />
            </div>
        </div>
        <div class="field">
            <label>@T("items.categoria")</label>
            <select class="select" value="@_category" @onchange="async e => { _category = e.Value?.ToString() ?? string.Empty; _page = 1; await ReloadAsync(); }">
                <option value="">@T("items.todas")</option>
                @foreach (var category in _categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>
        <div class="actions">
            <button class="btn btn-dark" disabled="@(!Session.Can(WmsPermissions.EditCatalog))" @onclick="() => Open(null)"><Icon Name="plus" Size="18" />@T("items.nuevo_articulo")</button>
        </div>
    </div>

    @if (_result is { } page)
    {
        @if (page.Total == 0 && !Loading)
        {
            <EmptyState Icon="tag" Title="@(_search != "" || _category != "" ? T("items.nada_coincide_con_la_busqueda") : T("items.el_catalogo_esta_vacio"))"
                        Text="@(T("items.los_articulos_llegan_desde_el"))" />
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr>
                            <th>@T("items.articulo")</th>
                            <th>@T("items.categoria")</th>
                            <th>@T("items.unidad")</th>
                            <th class="num">@T("items.precio")</th>
                            <th class="num">@T("items.stock_total")</th>
                            <th>@T("items.estado")</th>
                            <th class="actions-col">@T("items.acciones")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in page.Items)
                        {
                            <tr @key="item.Id">
                                <td>
                                    <div class="cell-main">
                                        <Avatar Text="@item.Name" Size="34" />
                                        <div class="two-line"><span class="t1">@item.Name</span><span class="t2">#@item.Sku</span></div>
                                    </div>
                                </td>
                                <td>
                                    <div class="two-line"><span class="t1">@(item.Category ?? T("items.sin_categoria"))</span><span class="t2">@(item.Barcode ?? T("items.sin_codigo_de_barras"))</span></div>
                                </td>
                                <td><span class="muted">@item.Unit</span></td>
                                <td class="num strong">@Fmt.Money(item.Price, item.CurrencyCode)</td>
                                <td class="num">
                                    @if (item.TrackInventory)
                                    {
                                        <div class="two-line" style="align-items:flex-end">
                                            <span class="t1">@Fmt.Qty(item.OnHand)</span>
                                            @if (item.Reserved > 0)
                                            {
                                                <span class="t2">@T("items.reservado", Fmt.Qty(item.Reserved))</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="faint">@(item.Kind == "Service" ? T("items.servicio") : T("items.no_controla_stock"))</span>
                                    }
                                </td>
                                <td>
                                    <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
                                        @if (item.IsActive)
                                        {
                                            <StatusPill Text="@(T("items.activo"))" Tone="good" />
                                        }
                                        else
                                        {
                                            <StatusPill Text="@(T("items.inactivo"))" Tone="neutral" />
                                        }
                                        @if (item.Pending)
                                        {
                                            <span class="tag" title="@(T("items.guardado_en_este_equipo_se"))">@T("items.por_enviar")</span>
                                        }
                                    </div>
                                </td>
                                <td class="actions-col">
                                    <KebabMenu>
                                        <button disabled="@(!Session.Can(WmsPermissions.EditCatalog))" @onclick="() => Open(item)"><Icon Name="edit" Size="18" />@T("items.editar")</button>
                                        @if (item.TrackInventory)
                                        {
                                            <a href="@($"inventario?q={Uri.EscapeDataString(item.Sku)}")"><Icon Name="boxes" Size="18" />@T("items.ver_stock_por_sede")</a>
                                            <a href="@($"movimientos?q={Uri.EscapeDataString(item.Sku)}")"><Icon Name="list" Size="18" />@T("items.ver_kardex")</a>
                                        }
                                    </KebabMenu>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Page="page.Page" PageSize="page.PageSize" Total="page.Total" Noun="@(T("items.articulos"))" OnPage="async p => { _page = p; await ReloadAsync(); }" />
        }
    }
</div>

@if (_form is { } f)
{
    <Modal Title="@(f.Id is null ? T("items.nuevo_articulo") : T("items.editar_articulo"))" Subtitle="@(T("items.se_guarda_en_este_equipo"))"
           Error="@_error" OnClose="Close">
        <ChildContent>
            <div class="segmented">
                <button class="@(f.Kind == "Product" ? "on" : "")" @onclick="@(() => f.Kind = "Product")">@T("items.producto")</button>
                <button class="@(f.Kind == "Service" ? "on" : "")" @onclick="@(() => f.Kind = "Service")">@T("items.servicio")</button>
            </div>
            <div class="form-row">
                <div class="field">
                    <label>@T("items.sku")</label>
                    <input class="control" placeholder="@(T("items.cafe_250"))" @bind="f.Sku" style="text-transform:uppercase" />
                </div>
                <div class="field">
                    <label>@T("items.codigo_de_barras")</label>
                    <input class="control" placeholder="7750000000017" @bind="f.Barcode" />
                </div>
            </div>
            <div class="field">
                <label>@T("items.nombre")</label>
                <input class="control" placeholder="@(T("items.cafe_tostado_250"))" @bind="f.Name" />
            </div>
            <div class="form-row">
                <div class="field">
                    <label>@T("items.categoria")</label>
                    <input class="control" list="item-categories" placeholder="@(T("items.bebidas"))" @bind="f.Category" />
                    <datalist id="item-categories">
                        @foreach (var category in _categories)
                        {
                            <option value="@category"></option>
                        }
                    </datalist>
                </div>
                <div class="field">
                    <label>@T("items.unidad")</label>
                    <input class="control" list="item-units" @bind="f.Unit" />
                    <datalist id="item-units">
                        @foreach (var unit in Units)
                        {
                            <option value="@unit"></option>
                        }
                    </datalist>
                </div>
            </div>
            <div class="form-row three">
                <div class="field">
                    <label>@T("items.precio_de_venta")</label>
                    <input class="control" type="number" min="0" step="0.01" @bind="f.Price" />
                </div>
                <div class="field">
                    <label>@T("items.moneda")</label>
                    <select class="select" @bind="f.Currency">
                        @foreach (var currency in Currencies.Union([f.Currency]))
                        {
                            <option value="@currency">@currency</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>@T("items.impuesto")</label>
                    <select class="select" @bind="f.TaxCode">
                        <option value="igv">@T("items.igv")</option>
                        <option value="exonerado">@T("items.exonerado")</option>
                        <option value="inafecto">@T("items.inafecto")</option>
                    </select>
                </div>
            </div>
            <div class="field">
                <label>@T("items.descripcion_opcional")</label>
                <input class="control" @bind="f.Description" />
            </div>
            <div style="display:flex;gap:22px;flex-wrap:wrap">
                @if (f.Kind == "Product")
                {
                    <label class="check"><input type="checkbox" @bind="f.TrackInventory" />@T("items.controlar_stock_en_el_almacen")</label>
                }
                <label class="check"><input type="checkbox" @bind="f.IsActive" />@T("items.activo")</label>
            </div>
            @if (f.Kind == "Product" && f.TrackInventory)
            {
                <div class="form-row three">
                    <div class="field">
                        <label>@T("items.codigo_de_unidad")</label>
                        <input class="control" list="item-unit-codes" placeholder="NIU" @bind="f.UnitCode" style="text-transform:uppercase" />
                        <datalist id="item-unit-codes">
                            @foreach (var unitCode in UnitCodes)
                            {
                                <option value="@unitCode"></option>
                            }
                        </datalist>
                    </div>
                    <div class="field">
                        <label>@T("items.peso_kg")</label>
                        <input class="control" type="number" min="0" step="0.001" @bind="f.WeightKg" />
                    </div>
                    <div class="field">
                        <label>@T("items.control")</label>
                        <select class="select" @bind="f.Tracking">
                            <option value="@ItemTrackings.None">@T("items.sin_lote_ni_serie")</option>
                            <option value="@ItemTrackings.Lot">@T("items.por_lote")</option>
                            <option value="@ItemTrackings.Serial">@T("items.por_serie")</option>
                        </select>
                    </div>
                </div>
                <div class="field">
                    <label>@T("items.presentaciones")</label>
                    <span class="hint">@T("items.presentaciones_ayuda")</span>
                    @foreach (var p in f.Presentations)
                    {
                        <div class="form-row presentation-row">
                            <input class="control" placeholder="@(T("items.caja"))" @bind="p.Name" aria-label="@(T("items.nombre"))" />
                            <input class="control" type="number" min="0" step="any" @bind="p.Factor" aria-label="@(T("items.factor"))" title="@(T("items.factor"))" />
                            <input class="control" placeholder="17750000000014" @bind="p.Barcode" aria-label="@(T("items.codigo_de_barras"))" />
                            <button class="btn btn-ghost icon-btn sm" @onclick="() => f.Presentations.Remove(p)" aria-label="@(T("items.quitar"))"><Icon Name="x" Size="16" /></button>
                        </div>
                    }
                    <button class="btn btn-ghost sm" @onclick="() => f.Presentations.Add(new PresentationForm())"><Icon Name="plus" Size="16" />@T("items.agregar_presentacion")</button>
                </div>
            }
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="Close">@T("items.cancelar")</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="SaveAsync">@(f.Id is null ? T("items.crear_articulo") : T("items.guardar_cambios"))</button>
        </Footer>
    </Modal>
}

@code {
    private sealed class ItemForm
    {
        public Guid? Id { get; init; }
        public string Kind { get; set; } = "Product";
        public string Sku { get; set; } = "";
        public string Name { get; set; } = "";
        public string? Barcode { get; set; }
        public string? Category { get; set; }
        public string Unit { get; set; } = "unidad";
        public decimal Price { get; set; }
        public string Currency { get; set; } = "PEN";
        public string TaxCode { get; set; } = "igv";
        public string? Description { get; set; }
        public bool TrackInventory { get; set; } = true;
        public bool IsActive { get; set; } = true;
        public string? UnitCode { get; set; }
        public decimal? WeightKg { get; set; }
        public string Tracking { get; set; } = ItemTrackings.None;
        public List<PresentationForm> Presentations { get; set; } = [];
    }

    private sealed class PresentationForm
    {
        public string? Code { get; set; }
        public string Name { get; set; } = "";
        public decimal Factor { get; set; } = 12;
        public string? Barcode { get; set; }
        public string? UnitCode { get; set; }

        /// <summary>Sin código propio, se deriva del nombre (Caja × 12 → CAJA-12).</summary>
        public ItemPresentation ToPresentation() => new(
            string.IsNullOrWhiteSpace(Code) ? $"{new string(Name.Where(char.IsLetter).Take(8).ToArray())}-{Factor:0.##}" : Code,
            Name, Factor, Barcode, UnitCode);
    }

    /// <summary>Códigos UN/ECE más usados (Tabla 6 de SUNAT).</summary>
    private static readonly string[] UnitCodes = ["NIU", "ZZ", "BX", "PK", "DZN", "KGM", "GRM", "LTR", "MLT", "MTR", "PR", "SET"];

    private static readonly string[] Units = ["unidad", "caja", "paquete", "docena", "kg", "g", "litro", "ml", "metro", "par", "servicio"];
    private static readonly string[] Currencies = ["PEN", "USD"];

    private const int PageSize = 12;
    private PagedResult<ItemRow>? _result;
    private IReadOnlyList<string> _categories = [];
    private string _search = "", _category = "";
    private int _page = 1;
    private string _currency = "PEN";
    private CancellationTokenSource? _debounce;
    private ItemForm? _form;
    private string? _error;
    private bool _busy;

    protected override async Task LoadAsync()
    {
        _categories = await Wms.Master.GetCategoriesAsync();
        _currency = (await Wms.Master.GetCompanyAsync())?.CurrencyCode ?? "PEN";
        _result = await Wms.Master.GetItemsAsync(_search, _category == "" ? null : _category, _page, PageSize);
        if (_result.Items.Count == 0 && _page > 1)
        {
            _page = _result.Pages;
            _result = await Wms.Master.GetItemsAsync(_search, _category == "" ? null : _category, _page, PageSize);
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(220, _debounce.Token);
            _page = 1;
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void Open(ItemRow? item)
    {
        _error = null;
        _form = item is null
            ? new ItemForm { Currency = _currency, Category = _category == "" ? null : _category }
            : new ItemForm
            {
                Id = item.Id, Kind = item.Kind, Sku = item.Sku, Name = item.Name, Barcode = item.Barcode, Category = item.Category,
                Unit = item.Unit, Price = item.Price, Currency = item.CurrencyCode, TaxCode = item.TaxCode ?? "igv",
                Description = item.Description, TrackInventory = item.TrackInventory, IsActive = item.IsActive,
                UnitCode = item.UnitCode, WeightKg = item.WeightKg, Tracking = item.Tracking,
                Presentations = item.Presentations.Select(p => new PresentationForm
                {
                    Code = p.Code, Name = p.Name, Factor = p.Factor, Barcode = p.Barcode, UnitCode = p.UnitCode,
                }).ToList(),
            };
    }

    private async Task SaveAsync()
    {
        if (_form is not { } f)
            return;
        var draft = new ItemDraft(f.Sku, f.Name, f.Unit, f.Category, f.Barcode, f.Price, f.Currency, f.Description,
            f.Kind == "Product" && f.TrackInventory, f.Kind, f.TaxCode, f.IsActive, f.UnitCode, f.WeightKg, f.Tracking,
            f.Presentations.Where(p => !string.IsNullOrWhiteSpace(p.Name)).Select(p => p.ToPresentation()).ToList());
        _busy = true;
        _error = await TryAsync(async () =>
        {
            if (f.Id is { } id)
                await Wms.Master.UpdateItemAsync(id, draft);
            else
                await Wms.Master.CreateItemAsync(draft);
        }, f.Id is null ? T("items.articulo_creado", f.Name.Trim()) : T("items.cambios_guardados"));
        _busy = false;
        if (_error is null)
            Close();
    }

    private void Close()
    {
        _form = null;
        _error = null;
    }

    public override void Dispose()
    {
        _debounce?.Cancel();
        base.Dispose();
    }
}
