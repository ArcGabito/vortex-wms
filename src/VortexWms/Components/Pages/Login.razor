@page "/login"
@layout EmptyLayout
@inject AppSession Session
@inject NavigationManager Nav

<div class="login">
    <div class="login-art">
        <Logo OnDark Size="38" />
        <h2>El almacén bajo control,<br /><em>con o sin internet.</em></h2>
        <p>Inventario, recepciones, despachos y kardex en tiempo real. Libre y de código abierto, conectado con Vortex ERP, CRM y POS.</p>
        <div class="chips">
            <span>AGPL-3.0</span>
            <span>Multi-almacén</span>
            <span>Funciona sin conexión</span>
            <span>Hecho en Perú</span>
        </div>
        <BoxArt Class="art" OnDark />
    </div>

    <form class="login-form" @onsubmit="SubmitAsync">
        <div>
            <h1>Inicia sesión</h1>
        </div>
        <p class="lead">Usa tu cuenta de la suite Vortex: es la misma para el ERP, CRM, WMS y POS.</p>

        @if ((_error ?? Session.SignedOutReason) is { } message)
        {
            <div class="alert error"><Icon Name="alert" Size="18" /><span>@message</span></div>
        }

        <div class="field">
            <label for="email">Correo</label>
            <input id="email" class="control" type="email" autocomplete="username" placeholder="tu@empresa.pe" @bind="_email" />
        </div>
        <div class="field">
            <label for="password">Contraseña</label>
            <input id="password" class="control" type="password" autocomplete="current-password" placeholder="••••••••" @bind="_password" />
        </div>

        @if (_showServer)
        {
            <div class="field">
                <label for="hub">Servidor del hub</label>
                <input id="hub" class="control" placeholder="https://hub.miempresa.pe" @bind="_hubUrl" />
            </div>
            <div class="field">
                <label for="key">Clave de sistema del WMS</label>
                <input id="key" class="control" type="password" @bind="_productKey" />
            </div>
        }

        <button class="btn btn-dark btn-block" type="submit" disabled="@_busy">
            @if (_busy)
            {
                <span class="spinner sm" style="border-color:rgba(255,255,255,.3);border-top-color:#fff"></span>
            }
            Ingresar
        </button>

        <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap">
            <button type="button" class="link-btn" @onclick="() => _showServer = !_showServer">
                @(_showServer ? "Ocultar servidor" : $"Servidor: {Host}")
            </button>
            @if (IsDebug)
            {
                <button type="button" class="link-btn" @onclick="FillDemo">Usar cuenta demo</button>
            }
        </div>
    </form>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private string _hubUrl = "";
    private string _productKey = "";
    private string? _error;
    private bool _busy;
    private bool _showServer;

#if DEBUG
    private static readonly bool IsDebug = true;
#else
    private static readonly bool IsDebug = false;
#endif

    private string Host => Uri.TryCreate(_hubUrl, UriKind.Absolute, out var uri) ? uri.Authority : _hubUrl;

    protected override void OnInitialized()
    {
        if (Session.IsSignedIn)
        {
            Nav.NavigateTo("", replace: true);
            return;
        }
        _hubUrl = Session.HubUrl;
        _productKey = Session.ProductKey;
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrEmpty(_password))
        {
            _error = "Ingresa tu correo y contraseña.";
            return;
        }
        _busy = true;
        _error = null;
        _error = await Session.LoginAsync(_email, _password, _hubUrl, _productKey);
        _busy = false;
        if (_error is null)
            Nav.NavigateTo("", replace: true);
    }

    private void FillDemo()
    {
        // Organización demo que crea el hub en desarrollo (vortex-api/docs/SISTEMAS.md).
        _email = "luis@vortex.local";
        _password = "Suite-Local-2026!";
    }
}
