@page "/pedidos"
@inherits WmsPage

<SectionContent SectionName="page-title">@T("orders.pedidos_2")</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("orders.pedidos_despachos")</h2>
            <p>@T("orders.los_pedidos_del_erp_del")</p>
        </div>
    </div>

    <div class="filters">
        <div class="field search">
            <label>@T("orders.buscar")</label>
            <div class="input-icon">
                <Icon Name="search" Size="16" />
                <input class="control" placeholder="@(T("orders.cliente_guia"))" value="@_search" @oninput="OnSearchInput" />
            </div>
        </div>
        <div class="field" style="width:auto">
            <label>@T("orders.estado")</label>
            <div class="segmented">
                @foreach (var (value, label) in Tabs)
                {
                    <button class="@(_status == value ? "on" : "")" @onclick="() => SetStatusAsync(value)">@label</button>
                }
            </div>
        </div>
        <div class="actions">
            <button class="btn btn-dark" disabled="@(!Session.Can(WmsPermissions.CreateOrder))" @onclick="OpenNew"><Icon Name="plus" Size="18" />@T("orders.nuevo_pedido")</button>
        </div>
    </div>

    @if (_result is { } page)
    {
        @if (page.Total == 0 && !Loading)
        {
            <EmptyState Icon="clipboard" Title="@(_status == "open" ? T("orders.no_hay_pedidos_por_despachar") : T("orders.no_hay_pedidos"))"
                        Text="@(T("orders.los_pedidos_que_se_registren"))" />
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr>
                            <th>@T("orders.pedido")</th>
                            <th>@T("orders.cliente")</th>
                            <th class="num">@T("orders.unidades")</th>
                            <th class="num">@T("orders.total")</th>
                            <th>@T("orders.fecha")</th>
                            <th>@T("orders.estado")</th>
                            <th class="actions-col">@T("orders.acciones")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in page.Items)
                        {
                            var (text, tone) = o.PendingApproval && OrderStatuses.IsOpen(o.Status) ? (T("orders.por_aprobar"), "bad") : StatusPill.ForOrder(o.Status);
                            var open = OrderStatuses.IsOpen(o.Status);
                            <tr @key="o.Id">
                                <td>
                                    <div class="cell-main">
                                        <div class="stat-icon" style="width:34px;height:34px;border-radius:10px"><Icon Name="@(o.Status == OrderStatuses.Dispatched ? "truck" : "clipboard")" Size="16" /></div>
                                        <div class="two-line"><span class="t1">@o.Number</span><span class="t2">@SourceLabel(o.Source)</span></div>
                                    </div>
                                </td>
                                <td style="max-width:260px">
                                    <div class="two-line">
                                        <span class="t1 @(o.CustomerName is null ? "faint" : "")">@(o.CustomerName ?? T("orders.cliente_sin_registrar"))</span>
                                        <span class="t2 @(o.SiteName is null ? "warn-text" : "")">@(o.SiteName is null ? T("orders.sede_por_asignar") : T("orders.desde", o.SiteName))</span>
                                    </div>
                                </td>
                                <td class="num">
                                    <div class="two-line" style="align-items:flex-end">
                                        <span class="t1">@Fmt.Qty(o.Units)</span>
                                        <span class="t2">@o.LineCount @(o.LineCount == 1 ? T("orders.articulo") : T("orders.articulos"))</span>
                                    </div>
                                </td>
                                <td class="num strong">@Fmt.Money(o.Total, o.CurrencyCode)</td>
                                <td>
                                    <div class="two-line">
                                        <span class="t1">@Fmt.Date(o.DispatchedAt ?? o.CreatedAt)</span>
                                        <span class="t2">
                                            @if (o.DispatchedAt is not null)
                                            {
                                                @T("orders.despachado")@(o.Carrier is null ? "" : $" · {o.Carrier}")@(o.TrackingNumber is null ? "" : $" · {o.TrackingNumber}")
                                            }
                                            else
                                            {
                                                @(T("orders.creado", Fmt.Ago(o.CreatedAt)))
                                            }
                                        </span>
                                    </div>
                                </td>
                                <td><StatusPill Text="@text" Tone="@tone" /></td>
                                <td class="actions-col">
                                    <KebabMenu>
                                        @if (open && !o.PendingApproval)
                                        {
                                            <button disabled="@(!Session.Can(WmsPermissions.Pick))" @onclick='() => Nav.NavigateTo($"preparar/{o.Id}")'><Icon Name="barcode" Size="18" />@T("orders.preparar_con_recorrido")</button>
                                        }
                                        @if (o.Status == OrderStatuses.Pending && !o.PendingApproval)
                                        {
                                            <button disabled="@(!Session.Can(WmsPermissions.Pick))" @onclick="() => StartPickingAsync(o)"><Icon Name="play" Size="18" />@T("orders.empezar_preparacion")</button>
                                        }
                                        @if (open && !o.PendingApproval)
                                        {
                                            <button disabled="@(!Session.Can(WmsPermissions.Dispatch))" @onclick="() => OpenDispatch(o)"><Icon Name="truck" Size="18" />@T("orders.despachar_2")</button>
                                        }
                                        <button @onclick="() => OpenDetail(o)"><Icon Name="eye" Size="18" />@(open ? T("orders.lista_de_picking") : T("orders.ver_detalle"))</button>
                                        @if (open)
                                        {
                                            <hr />
                                            <button class="danger" disabled="@(!Session.Can(WmsPermissions.CancelOrder))" @onclick="() => _cancel = o"><Icon Name="ban" Size="18" />@T("orders.cancelar_pedido")</button>
                                        }
                                    </KebabMenu>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Page="page.Page" PageSize="page.PageSize" Total="page.Total" Noun="@(T("orders.pedidos"))" OnPage="async p => { _page = p; await ReloadAsync(); }" />
        }
    }
</div>

@if (_new is { } n)
{
    <Modal Title="@(T("orders.nuevo_pedido"))" Subtitle="@(T("orders.reserva_el_stock_en_la"))" Size="lg" Error="@_error" OnClose="Close">
        <ChildContent>
            <div class="form-row">
                <div class="field">
                    <label>@T("orders.cliente")</label>
                    <select class="select" value="@n.CustomerId" @onchange="e => n.CustomerId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null">
                        <option value="">@T("orders.elige_el_cliente")</option>
                        @foreach (var customer in _customers)
                        {
                            <option value="@customer.Id">@customer.Label@(customer.Detail is null ? "" : $" · {customer.Detail}")</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>@T("orders.sede_que_despacha")</label>
                    <select class="select" value="@n.SiteId" @onchange="async e => { n.SiteId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null; if (_lines is not null) await _lines.RefreshAvailabilityAsync(); }">
                        <option value="">@T("orders.elige_la_sede")</option>
                        @foreach (var site in _sites)
                        {
                            <option value="@site.Id">@site.Name</option>
                        }
                    </select>
                </div>
            </div>
            @if (_customers.Count == 0)
            {
                <div class="alert info"><Icon Name="users" Size="18" /><span>@T("orders.aun_no_hay_clientes_crealos") <a href="socios">@T("orders.contactos")</a> @T("orders.en_el_crm")</span></div>
            }
            <LineEditor Changed="StateHasChanged" @ref="_lines" Lines="n.Lines" ShowPrice PriceLabel="@(T("orders.precio"))" DefaultPrice="i => i.Price" AvailableFor="AvailableAtSiteAsync" />
            @if (n.Lines.Count > 0)
            {
                <div style="display:flex;justify-content:flex-end;gap:10px;font-size:15px">
                    <span class="muted">@T("orders.total")</span>
                    <strong>@Fmt.Money(n.Lines.Sum(l => l.Quantity * (l.Price ?? 0)), _currency)</strong>
                </div>
            }
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="Close">@T("orders.cancelar")</button>
            <button class="btn btn-dark" disabled="@(_busy || n.Lines.Count == 0)" @onclick="SaveNewAsync">@T("orders.crear_pedido")</button>
        </Footer>
    </Modal>
}

@if (_dispatch is { } dp)
{
    <Modal Title="@(T("orders.despachar", dp.Order.Number))" Subtitle="@($"{dp.Order.CustomerName ?? "Cliente sin registrar"} · descuenta el stock y avisa a la suite.")"
           Size="lg" Error="@_error" OnClose="Close">
        <ChildContent>
            <div class="form-row three">
                <div class="field">
                    <label>@T("orders.sale_de")</label>
                    <select class="select" value="@dp.SiteId" @onchange="async e => { dp.SiteId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null; await RefreshPicksAsync(dp); }">
                        <option value="">@T("orders.elige_la_sede")</option>
                        @foreach (var site in _sites)
                        {
                            <option value="@site.Id">@site.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>@T("orders.transportista")</label>
                    <input class="control" placeholder="@(T("orders.olva_shalom_propio"))" @bind="dp.Carrier" />
                </div>
                <div class="field">
                    <label>@T("orders.de_guia")</label>
                    <input class="control" placeholder="T001-00012345" @bind="dp.Tracking" />
                </div>
            </div>
            <PickList Lines="dp.Lines" ShowStock="dp.SiteId == dp.Order.SiteId" />
            @if (dp.Picks.Count > 0)
            {
                <div class="card-body" style="padding:0;display:flex;flex-direction:column;gap:12px">
                    <h4 style="font-size:14px">@T("orders.lotes_y_series")</h4>
                    @foreach (var pick in dp.Picks)
                    {
                        <div @key="pick.Item.Id" class="line" style="grid-template-columns:1fr">
                            <div class="two-line">
                                <span class="t1">@pick.Item.Name · @Fmt.Qty(pick.Quantity) @pick.Item.Unit</span>
                                @if (pick.Item.Tracking == ItemTrackings.Lot && !pick.Choose)
                                {
                                    <span class="t2">@SuggestionText(pick)</span>
                                    @if (pick.Suggestion.Sum(s => s.Quantity) < pick.Quantity)
                                    {
                                        <span class="t2 warn-text">@T("orders.no_alcanzan_los_lotes")</span>
                                    }
                                }
                            </div>
                            @if (pick.Item.Tracking == ItemTrackings.Serial || pick.Choose)
                            {
                                <TrackingInput Item="pick.Item" Quantity="pick.Quantity" Lots="pick.Lots" @bind-SerialsText="pick.SerialsText"
                                               Available="pick.AvailableSerials" Changed="StateHasChanged" />
                            }
                            else if (Session.Can(WmsPermissions.ManageLots))
                            {
                                <button class="link-btn" style="justify-self:start" @onclick="() => pick.Choose = true">@T("orders.elegir_otros_lotes")</button>
                            }
                        </div>
                    }
                </div>
            }
            @if (dp.Partial)
            {
                <div class="alert warn"><Icon Name="alert" Size="18" /><span>@T("orders.despacho_parcial_explica")</span></div>
            }
            @if (dp.SiteId != dp.Order.SiteId && dp.Order.SiteId != Guid.Empty)
            {
                <div class="alert warn"><Icon Name="alert" Size="18" /><span>@T("orders.se_despachara_desde_otra_sede", dp.Order.SiteName)</span></div>
            }
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="Close">@T("orders.cancelar")</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="SaveDispatchAsync"><Icon Name="truck" Size="18" />@T("orders.confirmar_despacho")</button>
        </Footer>
    </Modal>
}

@if (_detail is { } dt)
{
    <Modal Title="@dt.Order.Number" Subtitle="@($"{dt.Order.CustomerName ?? "Cliente sin registrar"} · {dt.Order.SiteName ?? "sede por asignar"} · {SourceLabel(dt.Order.Source)}")"
           Size="lg" OnClose="Close">
        <ChildContent>
            <PickList Lines="dt.Lines" ShowStock="dt.Order.Status is OrderStatuses.Pending or OrderStatuses.Picking" ShowPrice />
            <div style="display:flex;justify-content:flex-end;gap:10px;font-size:15px">
                <span class="muted">@T("orders.total")</span>
                <strong>@Fmt.Money(dt.Order.Total, dt.Order.CurrencyCode)</strong>
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="Close">@T("orders.cerrar")</button>
        </Footer>
    </Modal>
}

@if (_cancel is { } cancel)
{
    <Modal Title="@(T("orders.cancelar_el_pedido"))" Subtitle="@(T("orders.se_cancelara_en_este_wms", cancel.Number))" OnClose="Close">
        <Footer>
            <button class="btn" @onclick="Close">@T("orders.volver")</button>
            <button class="btn btn-danger" disabled="@_busy" @onclick="CancelAsync">@T("orders.cancelar_pedido")</button>
        </Footer>
    </Modal>
}

@code {
    private sealed class NewForm
    {
        public Guid? CustomerId { get; set; }
        public Guid? SiteId { get; set; }
        public List<LineEditor.LineDraft> Lines { get; } = [];
    }

    private sealed class TrackedPick(ItemRow item, decimal quantity)
    {
        public ItemRow Item { get; } = item;
        public decimal Quantity { get; } = quantity;
        public IReadOnlyList<LotQuantity> Suggestion { get; set; } = [];
        public List<TrackingInput.LotDraft> Lots { get; } = [];
        public string SerialsText { get; set; } = "";
        public bool Choose { get; set; }
        public IReadOnlyList<string> AvailableSerials { get; set; } = [];

        public DocumentLine ToPick() => new(Item.Id, Quantity, null, Choose ? TrackingInput.ToLots(Lots) : null,
            TrackingInput.Parse(SerialsText) is { Count: > 0 } s ? s : null);
    }

    private sealed class DispatchForm(OrderRow order, IReadOnlyList<OrderLineRow> lines)
    {
        public OrderRow Order { get; } = order;
        public IReadOnlyList<OrderLineRow> Lines { get; } = lines;
        public List<TrackedPick> Picks { get; } = [];
        public Guid? SiteId { get; set; } = order.SiteId == Guid.Empty ? null : order.SiteId;
        public string? Carrier { get; set; }
        public string? Tracking { get; set; }

        /// <summary>Se preparó con recorrido y no está todo: sale lo tomado y el resto queda pendiente.</summary>
        public bool Partial { get; set; }
    }

    [SupplyParameterFromQuery(Name = "despachar")] public Guid? Despachar { get; set; }

    private sealed record DetailView(OrderRow Order, IReadOnlyList<OrderLineRow> Lines);

    private static readonly (string Value, string Label)[] Tabs =
    [
        ("open", T("orders.por_despachar")), (OrderStatuses.Dispatched, T("orders.despachados")), (OrderStatuses.Cancelled, T("orders.cancelados")), ("", T("orders.todos")),
    ];

    private const int PageSize = 10;
    private PagedResult<OrderRow>? _result;
    private IReadOnlyList<SiteRow> _sites = [];
    private IReadOnlyList<Option> _customers = [];
    private string _search = "", _status = "open", _currency = "PEN";
    private int _page = 1;
    private bool _statusChosen;
    private CancellationTokenSource? _debounce;

    private NewForm? _new;
    private DispatchForm? _dispatch;
    private DetailView? _detail;
    private OrderRow? _cancel;
    private LineEditor? _lines;
    private string? _error;
    private bool _busy;

    protected override async Task LoadAsync()
    {
        _sites = await Wms.Master.GetSitesAsync(activeOnly: true, mineOnly: true);
        _customers = await Wms.Master.GetPartyOptionsAsync(suppliers: false);
        _currency = (await Wms.Master.GetCompanyAsync())?.CurrencyCode ?? "PEN";
        _result = await Wms.Orders.GetOrdersAsync(_search, _status, _page, PageSize);
        if (!_statusChosen && _result.Total == 0 && _search == "")
        {
            _statusChosen = true;
            _status = "";
            _result = await Wms.Orders.GetOrdersAsync(_search, _status, _page, PageSize);
        }
        if (_result.Items.Count == 0 && _page > 1)
        {
            _page = _result.Pages;
            _result = await Wms.Orders.GetOrdersAsync(_search, _status, _page, PageSize);
        }
        // Viene de la pantalla de preparación: abre el despacho de ese pedido.
        if (Despachar is { } id && _dispatch is null && await Wms.Orders.GetAsync(id) is { } toDispatch)
        {
            Despachar = null;
            await OpenDispatch(toDispatch);
        }
    }

    private static string SourceLabel(string source) => source.ToUpperInvariant() switch
    {
        "ERP" => T("orders.pedido_del_erp"),
        "CRM" => T("orders.pedido_del_crm"),
        "POS" => T("orders.pedido_del_pos"),
        "WMS" => T("orders.creado_en_el_wms"),
        var other => T("orders.pedido_de", other),
    };

    private async Task SetStatusAsync(string status)
    {
        _statusChosen = true;
        _status = status;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(220, _debounce.Token);
            _page = 1;
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void OpenNew()
    {
        _error = null;
        _new = new NewForm { SiteId = Session.DefaultSiteId ?? _sites.FirstOrDefault()?.Id };
    }

    private async Task<decimal?> AvailableAtSiteAsync(ItemRow item) =>
        _new?.SiteId is { } site ? await Wms.Inventory.GetAvailableAsync(site, item.Id) : null;

    private async Task SaveNewAsync()
    {
        if (_new is not { } n)
            return;
        if (n.CustomerId is not { } customer || n.SiteId is not { } site)
        {
            _error = T("orders.elige_el_cliente_la_sede");
            return;
        }
        _busy = true;
        string? number = null;
        _error = await TryAsync(async () => number = await Wms.Orders.CreateAsync(customer, site, n.Lines.Select(l => l.ToDocumentLine()).ToList(), _currency));
        _busy = false;
        if (_error is null)
        {
            Toasts.Success(T("orders.pedido_creado_stock_reservado", number));
            Close();
        }
    }

    private Task StartPickingAsync(OrderRow order) =>
        RunAsync(() => Wms.Orders.StartPickingAsync(order.Id), T("orders.en_preparacion", order.Number));

    private async Task OpenDispatch(OrderRow order)
    {
        _error = null;
        var dispatch = new DispatchForm(order, await Wms.Orders.GetLinesAsync(order.Id));
        // Si se preparó con recorrido sale lo tomado; si no, todo lo que falta despachar.
        var list = await Wms.Orders.GetPickListAsync(order.Id);
        var guided = list is { Picked.Count: > 0 };
        dispatch.Partial = guided && !list!.Complete;
        foreach (var group in dispatch.Lines.GroupBy(l => l.ItemId))
        {
            var quantity = guided ? list!.Picked.Where(p => p.ItemId == group.Key).Sum(p => p.Quantity) : group.Sum(l => l.Quantity - l.Shipped);
            if (quantity > 0 && await Wms.Master.GetItemAsync(group.Key) is { Tracking: not ItemTrackings.None } item)
                dispatch.Picks.Add(new TrackedPick(item, quantity));
        }
        _dispatch = dispatch;
        await RefreshPicksAsync(dispatch);
    }

    private static string SuggestionText(TrackedPick pick) => T("orders.fefo_saca", string.Join(", ", pick.Suggestion.Select(s =>
        (s.LotCode.Length == 0 ? T("orders.sin_lote") : s.LotCode) + " × " + Fmt.Qty(s.Quantity) + (s.ExpiresAt is { } e ? " (" + Fmt.Date(e) + ")" : ""))));

    /// <summary>Sugerencia FEFO y series en stock de la sede desde la que sale.</summary>
    private async Task RefreshPicksAsync(DispatchForm dp)
    {
        if (dp.SiteId is not { } site)
            return;
        foreach (var pick in dp.Picks)
        {
            pick.Suggestion = await Wms.Lots.SuggestAsync(site, pick.Item.Id, pick.Quantity);
            pick.AvailableSerials = pick.Item.Tracking == ItemTrackings.Serial
                ? (await Wms.Lots.GetSerialsAsync(pick.Item.Id, site)).Select(s => s.Serial).ToList() : [];
        }
    }

    private async Task SaveDispatchAsync()
    {
        if (_dispatch is not { } dp)
            return;
        if (dp.SiteId is not { } site)
        {
            _error = T("orders.elige_la_sede_desde_la");
            return;
        }
        _busy = true;
        string? shipment = null;
        _error = await TryAsync(async () => shipment = await Wms.Orders.DispatchAsync(dp.Order.Id, dp.Carrier, dp.Tracking, site,
            dp.Picks.Select(p => p.ToPick()).ToList(), allowPartial: dp.Partial));
        _busy = false;
        if (_error is null)
        {
            Toasts.Success(T("orders.despachado_guia_interna", dp.Order.Number, shipment));
            Close();
        }
    }

    private async Task OpenDetail(OrderRow order) =>
        _detail = new DetailView(order, await Wms.Orders.GetLinesAsync(order.Id));

    private async Task CancelAsync()
    {
        if (_cancel is not { } order)
            return;
        _busy = true;
        await RunAsync(() => Wms.Orders.CancelAsync(order.Id), T("orders.cancelado", order.Number));
        _busy = false;
        Close();
    }

    private void Close()
    {
        _new = null;
        _dispatch = null;
        _detail = null;
        _cancel = null;
        _error = null;
    }

    public override void Dispose()
    {
        _debounce?.Cancel();
        base.Dispose();
    }
}
