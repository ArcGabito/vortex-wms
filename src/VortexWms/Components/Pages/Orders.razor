@page "/pedidos"
@inherits WmsPage

<SectionContent SectionName="page-title">Pedidos</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>Pedidos y despachos</h2>
            <p>Los pedidos del ERP y del CRM llegan aquí con su stock reservado. Prepáralos y despáchalos desde el almacén.</p>
        </div>
    </div>

    <div class="filters">
        <div class="field search">
            <label>Buscar</label>
            <div class="input-icon">
                <Icon Name="search" Size="16" />
                <input class="control" placeholder="N.º, cliente o guía" value="@_search" @oninput="OnSearchInput" />
            </div>
        </div>
        <div class="field" style="width:auto">
            <label>Estado</label>
            <div class="segmented">
                @foreach (var (value, label) in Tabs)
                {
                    <button class="@(_status == value ? "on" : "")" @onclick="() => SetStatusAsync(value)">@label</button>
                }
            </div>
        </div>
        <div class="actions">
            <button class="btn btn-dark" disabled="@(!Session.Can(WmsPermissions.CreateOrder))" @onclick="OpenNew"><Icon Name="plus" Size="18" />Nuevo pedido</button>
        </div>
    </div>

    @if (_result is { } page)
    {
        @if (page.Total == 0 && !Loading)
        {
            <EmptyState Icon="clipboard" Title="@(_status == "open" ? "No hay pedidos por despachar" : "No hay pedidos")"
                        Text="Los pedidos que se registren en el ERP o el CRM aparecerán aquí automáticamente." />
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr>
                            <th>Pedido</th>
                            <th>Cliente</th>
                            <th class="num">Unidades</th>
                            <th class="num">Total</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th class="actions-col">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in page.Items)
                        {
                            var (text, tone) = StatusPill.ForOrder(o.Status);
                            var open = o.Status is OrderStatuses.Pending or OrderStatuses.Picking;
                            <tr @key="o.Id">
                                <td>
                                    <div class="cell-main">
                                        <div class="stat-icon" style="width:34px;height:34px;border-radius:10px"><Icon Name="@(o.Status == OrderStatuses.Dispatched ? "truck" : "clipboard")" Size="16" /></div>
                                        <div class="two-line"><span class="t1">@o.Number</span><span class="t2">@SourceLabel(o.Source)</span></div>
                                    </div>
                                </td>
                                <td style="max-width:260px">
                                    <div class="two-line">
                                        <span class="t1 @(o.CustomerName is null ? "faint" : "")">@(o.CustomerName ?? "Cliente sin registrar")</span>
                                        <span class="t2 @(o.SiteName is null ? "warn-text" : "")">@(o.SiteName is null ? "Sede por asignar" : $"Desde {o.SiteName}")</span>
                                    </div>
                                </td>
                                <td class="num">
                                    <div class="two-line" style="align-items:flex-end">
                                        <span class="t1">@Fmt.Qty(o.Units)</span>
                                        <span class="t2">@o.LineCount @(o.LineCount == 1 ? "artículo" : "artículos")</span>
                                    </div>
                                </td>
                                <td class="num strong">@Fmt.Money(o.Total, o.CurrencyCode)</td>
                                <td>
                                    <div class="two-line">
                                        <span class="t1">@Fmt.Date(o.DispatchedAt ?? o.CreatedAt)</span>
                                        <span class="t2">
                                            @if (o.DispatchedAt is not null)
                                            {
                                                @($"Despachado{(o.Carrier is null ? "" : $" · {o.Carrier}")}{(o.TrackingNumber is null ? "" : $" · {o.TrackingNumber}")}")
                                            }
                                            else
                                            {
                                                @($"Creado {Fmt.Ago(o.CreatedAt)}")
                                            }
                                        </span>
                                    </div>
                                </td>
                                <td><StatusPill Text="@text" Tone="@tone" /></td>
                                <td class="actions-col">
                                    <KebabMenu>
                                        @if (o.Status == OrderStatuses.Pending)
                                        {
                                            <button disabled="@(!Session.Can(WmsPermissions.Pick))" @onclick="() => StartPickingAsync(o)"><Icon Name="play" Size="18" />Empezar preparación</button>
                                        }
                                        @if (open)
                                        {
                                            <button disabled="@(!Session.Can(WmsPermissions.Dispatch))" @onclick="() => OpenDispatch(o)"><Icon Name="truck" Size="18" />Despachar</button>
                                        }
                                        <button @onclick="() => OpenDetail(o)"><Icon Name="eye" Size="18" />@(open ? "Lista de picking" : "Ver detalle")</button>
                                        @if (open)
                                        {
                                            <hr />
                                            <button class="danger" disabled="@(!Session.Can(WmsPermissions.CancelOrder))" @onclick="() => _cancel = o"><Icon Name="ban" Size="18" />Cancelar pedido</button>
                                        }
                                    </KebabMenu>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Page="page.Page" PageSize="page.PageSize" Total="page.Total" Noun="pedidos" OnPage="async p => { _page = p; await ReloadAsync(); }" />
        }
    }
</div>

@if (_new is { } n)
{
    <Modal Title="Nuevo pedido" Subtitle="Reserva el stock en la sede elegida y avisa al ERP y al CRM." Size="lg" Error="@_error" OnClose="Close">
        <ChildContent>
            <div class="form-row">
                <div class="field">
                    <label>Cliente</label>
                    <select class="select" value="@n.CustomerId" @onchange="e => n.CustomerId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null">
                        <option value="">Elige el cliente</option>
                        @foreach (var customer in _customers)
                        {
                            <option value="@customer.Id">@customer.Label@(customer.Detail is null ? "" : $" · {customer.Detail}")</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Sede que despacha</label>
                    <select class="select" value="@n.SiteId" @onchange="async e => { n.SiteId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null; if (_lines is not null) await _lines.RefreshAvailabilityAsync(); }">
                        <option value="">Elige la sede</option>
                        @foreach (var site in _sites)
                        {
                            <option value="@site.Id">@site.Name</option>
                        }
                    </select>
                </div>
            </div>
            @if (_customers.Count == 0)
            {
                <div class="alert info"><Icon Name="users" Size="18" /><span>Aún no hay clientes. Créalos en <a href="socios">Contactos</a> o en el CRM.</span></div>
            }
            <LineEditor Changed="StateHasChanged" @ref="_lines" Lines="n.Lines" ShowPrice PriceLabel="Precio" DefaultPrice="i => i.Price" AvailableFor="AvailableAtSiteAsync" />
            @if (n.Lines.Count > 0)
            {
                <div style="display:flex;justify-content:flex-end;gap:10px;font-size:15px">
                    <span class="muted">Total</span>
                    <strong>@Fmt.Money(n.Lines.Sum(l => l.Quantity * (l.Price ?? 0)), _currency)</strong>
                </div>
            }
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="Close">Cancelar</button>
            <button class="btn btn-dark" disabled="@(_busy || n.Lines.Count == 0)" @onclick="SaveNewAsync">Crear pedido</button>
        </Footer>
    </Modal>
}

@if (_dispatch is { } dp)
{
    <Modal Title="@($"Despachar {dp.Order.Number}")" Subtitle="@($"{dp.Order.CustomerName ?? "Cliente sin registrar"} · descuenta el stock y avisa a la suite.")"
           Size="lg" Error="@_error" OnClose="Close">
        <ChildContent>
            <div class="form-row three">
                <div class="field">
                    <label>Sale de</label>
                    <select class="select" value="@dp.SiteId" @onchange="e => dp.SiteId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null">
                        <option value="">Elige la sede</option>
                        @foreach (var site in _sites)
                        {
                            <option value="@site.Id">@site.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Transportista</label>
                    <input class="control" placeholder="Olva, Shalom, propio…" @bind="dp.Carrier" />
                </div>
                <div class="field">
                    <label>N.º de guía</label>
                    <input class="control" placeholder="T001-00012345" @bind="dp.Tracking" />
                </div>
            </div>
            <PickList Lines="dp.Lines" ShowStock="dp.SiteId == dp.Order.SiteId" />
            @if (dp.SiteId != dp.Order.SiteId && dp.Order.SiteId != Guid.Empty)
            {
                <div class="alert warn"><Icon Name="alert" Size="18" /><span>Se despachará desde otra sede: la reserva en @dp.Order.SiteName se libera igual.</span></div>
            }
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="Close">Cancelar</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="SaveDispatchAsync"><Icon Name="truck" Size="18" />Confirmar despacho</button>
        </Footer>
    </Modal>
}

@if (_detail is { } dt)
{
    <Modal Title="@dt.Order.Number" Subtitle="@($"{dt.Order.CustomerName ?? "Cliente sin registrar"} · {dt.Order.SiteName ?? "sede por asignar"} · {SourceLabel(dt.Order.Source)}")"
           Size="lg" OnClose="Close">
        <ChildContent>
            <PickList Lines="dt.Lines" ShowStock="dt.Order.Status is OrderStatuses.Pending or OrderStatuses.Picking" ShowPrice />
            <div style="display:flex;justify-content:flex-end;gap:10px;font-size:15px">
                <span class="muted">Total</span>
                <strong>@Fmt.Money(dt.Order.Total, dt.Order.CurrencyCode)</strong>
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="Close">Cerrar</button>
        </Footer>
    </Modal>
}

@if (_cancel is { } cancel)
{
    <Modal Title="¿Cancelar el pedido?" Subtitle="@($"{cancel.Number} se cancelará en este WMS y se liberará el stock reservado.")" OnClose="Close">
        <Footer>
            <button class="btn" @onclick="Close">Volver</button>
            <button class="btn btn-danger" disabled="@_busy" @onclick="CancelAsync">Cancelar pedido</button>
        </Footer>
    </Modal>
}

@code {
    private sealed class NewForm
    {
        public Guid? CustomerId { get; set; }
        public Guid? SiteId { get; set; }
        public List<LineEditor.LineDraft> Lines { get; } = [];
    }

    private sealed class DispatchForm(OrderRow order, IReadOnlyList<OrderLineRow> lines)
    {
        public OrderRow Order { get; } = order;
        public IReadOnlyList<OrderLineRow> Lines { get; } = lines;
        public Guid? SiteId { get; set; } = order.SiteId == Guid.Empty ? null : order.SiteId;
        public string? Carrier { get; set; }
        public string? Tracking { get; set; }
    }

    private sealed record DetailView(OrderRow Order, IReadOnlyList<OrderLineRow> Lines);

    private static readonly (string Value, string Label)[] Tabs =
    [
        ("open", "Por despachar"), (OrderStatuses.Dispatched, "Despachados"), (OrderStatuses.Cancelled, "Cancelados"), ("", "Todos"),
    ];

    private const int PageSize = 10;
    private PagedResult<OrderRow>? _result;
    private IReadOnlyList<SiteRow> _sites = [];
    private IReadOnlyList<Option> _customers = [];
    private string _search = "", _status = "open", _currency = "PEN";
    private int _page = 1;
    private bool _statusChosen;
    private CancellationTokenSource? _debounce;

    private NewForm? _new;
    private DispatchForm? _dispatch;
    private DetailView? _detail;
    private OrderRow? _cancel;
    private LineEditor? _lines;
    private string? _error;
    private bool _busy;

    protected override async Task LoadAsync()
    {
        _sites = await Wms.Master.GetSitesAsync(activeOnly: true);
        _customers = await Wms.Master.GetPartyOptionsAsync(suppliers: false);
        _currency = (await Wms.Master.GetCompanyAsync())?.CurrencyCode ?? "PEN";
        _result = await Wms.Orders.GetOrdersAsync(_search, _status, _page, PageSize);
        if (!_statusChosen && _result.Total == 0 && _search == "")
        {
            _statusChosen = true;
            _status = "";
            _result = await Wms.Orders.GetOrdersAsync(_search, _status, _page, PageSize);
        }
        if (_result.Items.Count == 0 && _page > 1)
        {
            _page = _result.Pages;
            _result = await Wms.Orders.GetOrdersAsync(_search, _status, _page, PageSize);
        }
    }

    private static string SourceLabel(string source) => source.ToUpperInvariant() switch
    {
        "ERP" => "Pedido del ERP",
        "CRM" => "Pedido del CRM",
        "POS" => "Pedido del POS",
        "WMS" => "Creado en el WMS",
        var other => $"Pedido de {other}",
    };

    private async Task SetStatusAsync(string status)
    {
        _statusChosen = true;
        _status = status;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(220, _debounce.Token);
            _page = 1;
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void OpenNew()
    {
        _error = null;
        _new = new NewForm { SiteId = Session.DefaultSiteId ?? _sites.FirstOrDefault()?.Id };
    }

    private async Task<decimal?> AvailableAtSiteAsync(ItemRow item) =>
        _new?.SiteId is { } site ? await Wms.Inventory.GetAvailableAsync(site, item.Id) : null;

    private async Task SaveNewAsync()
    {
        if (_new is not { } n)
            return;
        if (n.CustomerId is not { } customer || n.SiteId is not { } site)
        {
            _error = "Elige el cliente y la sede que despacha.";
            return;
        }
        _busy = true;
        string? number = null;
        _error = await TryAsync(async () => number = await Wms.Orders.CreateAsync(customer, site, n.Lines.Select(l => l.ToDocumentLine()).ToList(), _currency));
        _busy = false;
        if (_error is null)
        {
            Toasts.Success($"Pedido {number} creado y stock reservado.");
            Close();
        }
    }

    private Task StartPickingAsync(OrderRow order) =>
        RunAsync(() => Wms.Orders.StartPickingAsync(order.Id), $"{order.Number} en preparación.");

    private async Task OpenDispatch(OrderRow order)
    {
        _error = null;
        _dispatch = new DispatchForm(order, await Wms.Orders.GetLinesAsync(order.Id));
    }

    private async Task SaveDispatchAsync()
    {
        if (_dispatch is not { } dp)
            return;
        if (dp.SiteId is not { } site)
        {
            _error = "Elige la sede desde la que sale el pedido.";
            return;
        }
        _busy = true;
        string? shipment = null;
        _error = await TryAsync(async () => shipment = await Wms.Orders.DispatchAsync(dp.Order.Id, dp.Carrier, dp.Tracking, site));
        _busy = false;
        if (_error is null)
        {
            Toasts.Success($"{dp.Order.Number} despachado (guía interna {shipment}).");
            Close();
        }
    }

    private async Task OpenDetail(OrderRow order) =>
        _detail = new DetailView(order, await Wms.Orders.GetLinesAsync(order.Id));

    private async Task CancelAsync()
    {
        if (_cancel is not { } order)
            return;
        _busy = true;
        await RunAsync(() => Wms.Orders.CancelAsync(order.Id), $"{order.Number} cancelado.");
        _busy = false;
        Close();
    }

    private void Close()
    {
        _new = null;
        _dispatch = null;
        _detail = null;
        _cancel = null;
        _error = null;
    }

    public override void Dispose()
    {
        _debounce?.Cancel();
        base.Dispose();
    }
}
