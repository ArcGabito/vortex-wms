@page "/sedes"
@inherits WmsPage

<SectionContent SectionName="page-title">@T("sites.almacenes")</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("sites.almacenes_tiendas")</h2>
            <p>@T("sites.las_sedes_son_comunes_toda")</p>
        </div>
        <button class="btn btn-dark" disabled="@(!Session.Can(WmsPermissions.EditCatalog))" @onclick="Open"><Icon Name="plus" Size="18" />@T("sites.nueva_sede")</button>
    </div>

    @if (_sites.Count == 0 && !Loading)
    {
        <EmptyState Icon="warehouse" Title="@(T("sites.aun_no_hay_sedes"))" Text="@(T("sites.crea_tu_primer_almacen_para"))" />
    }
    else
    {
        <div class="grid-cards">
            @foreach (var site in _sites)
            {
                var isDefault = Session.DefaultSiteId == site.Id;
                <div class="card site-card" @key="site.Id">
                    <div class="top">
                        <div class="stat-icon"><Icon Name="@(site.Kind == "Store" ? "tag" : site.Kind == "Office" ? "home" : "warehouse")" Size="20" /></div>
                        <div class="two-line" style="flex:1">
                            <span class="t1">@site.Name</span>
                            <span class="t2">@site.Code · @Fmt.SiteKind(site.Kind)</span>
                        </div>
                        @if (!site.IsActive)
                        {
                            <StatusPill Text="@(T("sites.inactiva"))" Tone="neutral" />
                        }
                        else if (isDefault)
                        {
                            <StatusPill Text="@(T("sites.por_defecto"))" Tone="accent" />
                        }
                    </div>
                    <div class="figures">
                        <div><strong>@Fmt.Compact(site.SkuCount)</strong><span>@T("sites.articulos_con_stock")</span></div>
                        <div><strong>@Fmt.Compact(site.Units)</strong><span>@T("sites.unidades")</span></div>
                    </div>
                    <div class="muted" style="font-size:12.5px;display:flex;gap:6px;align-items:center;min-height:18px">
                        @if (Address(site) is { } address)
                        {
                            <Icon Name="pin" Size="15" />
                            <span>@address</span>
                        }
                        @if (site.Pending)
                        {
                            <span class="tag" title="@(T("sites.guardada_en_este_equipo_se"))">@T("sites.por_enviar")</span>
                        }
                    </div>
                    <hr class="divider" />
                    <div style="display:flex;gap:8px;flex-wrap:wrap">
                        <a class="btn btn-sm" href="@($"inventario?sede={site.Id}")"><Icon Name="boxes" Size="16" />@T("sites.ver_stock")</a>
                        @if (site.IsActive && !isDefault)
                        {
                            <button class="btn btn-sm btn-ghost" @onclick="() => Session.SetDefaultSite(site.Id)"><Icon Name="star" Size="16" />@T("sites.usar_por_defecto")</button>
                        }
                        else if (isDefault)
                        {
                            <button class="btn btn-sm btn-ghost" @onclick="() => Session.SetDefaultSite(null)">@T("sites.quitar_por_defecto")</button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (_form is { } f)
{
    <Modal Title="@(T("sites.nueva_sede"))" Subtitle="@(T("sites.se_crea_en_el_hub"))" Error="@_error" OnClose="Close">
        <ChildContent>
            <div class="segmented">
                @foreach (var (value, label) in Kinds)
                {
                    <button class="@(f.Kind == value ? "on" : "")" @onclick="() => f.Kind = value">@label</button>
                }
            </div>
            <div class="form-row">
                <div class="field">
                    <label>@T("sites.codigo")</label>
                    <input class="control" placeholder="@(T("sites.alm_02"))" style="text-transform:uppercase" @bind="f.Code" />
                </div>
                <div class="field">
                    <label>@T("sites.telefono")</label>
                    <input class="control" placeholder="01 234 5678" @bind="f.Phone" />
                </div>
            </div>
            <div class="field">
                <label>@T("sites.nombre")</label>
                <input class="control" placeholder="@(T("sites.almacen_ate"))" @bind="f.Name" />
            </div>
            <div class="field">
                <label>@T("sites.direccion")</label>
                <input class="control" placeholder="@(T("sites.av_separadora_industrial_123"))" @bind="f.Address" />
            </div>
            <div class="form-row">
                <div class="field">
                    <label>@T("sites.ciudad")</label>
                    <input class="control" placeholder="@(T("sites.lima"))" @bind="f.City" />
                </div>
                <div class="field">
                    <label>@T("sites.pais")</label>
                    <select class="select" @bind="f.Country">
                        @foreach (var (country, name) in Countries)
                        {
                            <option value="@country">@name</option>
                        }
                    </select>
                </div>
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="Close">@T("sites.cancelar")</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="SaveAsync">@T("sites.crear_sede")</button>
        </Footer>
    </Modal>
}

@code {
    private sealed class SiteForm
    {
        public string Kind { get; set; } = "Warehouse";
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string? Phone { get; set; }
        public string? Address { get; set; }
        public string? City { get; set; }
        public string Country { get; set; } = "PE";
    }

    private static (string, string)[] Kinds => [("Warehouse", T("sites.almacen")), ("Store", T("sites.tienda")), ("Office", T("sites.oficina")), ("Other", T("sites.otro"))];

    internal static readonly (string Code, string Name)[] Countries =
    [
        ("PE", T("sites.peru")), ("AR", T("sites.argentina")), ("BO", T("sites.bolivia")), ("BR", T("sites.brasil")), ("CL", T("sites.chile")), ("CO", T("sites.colombia")),
        ("CR", T("sites.costa_rica")), ("EC", T("sites.ecuador")), ("SV", T("sites.el_salvador")), ("ES", T("sites.espana")), ("US", T("sites.estados_unidos")),
        ("GT", T("sites.guatemala")), ("HN", T("sites.honduras")), ("MX", T("sites.mexico")), ("NI", T("sites.nicaragua")), ("PA", T("sites.panama")), ("PY", T("sites.paraguay")),
        ("DO", T("sites.republica_dominicana")), ("UY", T("sites.uruguay")), ("VE", T("sites.venezuela")),
    ];

    private IReadOnlyList<SiteRow> _sites = [];
    private SiteForm? _form;
    private string? _error;
    private bool _busy;

    protected override async Task LoadAsync() => _sites = await Wms.Master.GetSitesAsync();

    private static string? Address(SiteRow site) =>
        string.Join(", ", new[] { site.AddressLine, site.City }.Where(s => !string.IsNullOrWhiteSpace(s))) is { Length: > 0 } text ? text : null;

    private void Open()
    {
        _error = null;
        _form = new SiteForm { Country = (_sites.FirstOrDefault()?.CountryCode) ?? "PE" };
    }

    private async Task SaveAsync()
    {
        if (_form is not { } f)
            return;
        _busy = true;
        _error = await TryAsync(() => Wms.Master.CreateSiteAsync(new SiteDraft(f.Code, f.Name, f.Kind, f.Phone, f.Address, f.City, f.Country)),
            T("sites.sede_creada", f.Name.Trim()));
        _busy = false;
        if (_error is null)
            Close();
    }

    private void Close()
    {
        _form = null;
        _error = null;
    }
}
