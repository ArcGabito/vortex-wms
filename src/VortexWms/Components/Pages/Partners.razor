@page "/socios"
@inherits WmsPage

<SectionContent SectionName="page-title">@T("partners.clientes_proveedores")</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("partners.clientes_proveedores")</h2>
            <p>@T("partners.un_solo_directorio_para_la")</p>
        </div>
    </div>

    <div class="filters">
        <div class="field search">
            <label>@T("partners.buscar")</label>
            <div class="input-icon">
                <Icon Name="search" Size="16" />
                <input class="control" placeholder="@(T("partners.nombre_ruc_dni"))" value="@_search" @oninput="OnSearchInput" />
            </div>
        </div>
        <div class="field" style="width:auto">
            <label>@T("partners.mostrar")</label>
            <div class="segmented">
                @foreach (var (value, label) in Tabs)
                {
                    <button class="@(_tab == value ? "on" : "")" @onclick="() => SetTabAsync(value)">@label</button>
                }
            </div>
        </div>
        <div class="actions">
            <button class="btn btn-dark" disabled="@(!Session.Can(WmsPermissions.CreateParty))" @onclick="Open"><Icon Name="plus" Size="18" />@T("partners.nuevo_registro")</button>
        </div>
    </div>

    @if (_result is { } page)
    {
        @if (page.Total == 0 && !Loading)
        {
            <EmptyState Icon="users" Title="@(T("partners.no_hay_registros"))" Text="@(T("partners.los_clientes_proveedores_llegan_desde"))" />
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr>
                            <th>@T("partners.nombre")</th>
                            <th>@T("partners.documento")</th>
                            <th>@T("partners.contacto")</th>
                            <th>@T("partners.ciudad")</th>
                            <th>@T("partners.rol")</th>
                            <th>@T("partners.estado")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in page.Items)
                        {
                            <tr @key="p.Id">
                                <td>
                                    <div class="cell-main">
                                        <Avatar Text="@p.Name" Size="34" />
                                        <div class="two-line">
                                            <span class="t1">@p.Name</span>
                                            <span class="t2">@(p.TradeName ?? (p.Kind == "Person" ? T("partners.persona") : T("partners.empresa")))</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (p.DocumentNumber is not null)
                                    {
                                        <div class="two-line"><span class="t1">@p.DocumentNumber</span><span class="t2">@p.DocumentType</span></div>
                                    }
                                    else
                                    {
                                        <span class="faint">@T("partners.sin_documento")</span>
                                    }
                                </td>
                                <td>
                                    <div class="two-line">
                                        <span class="t1" style="font-weight:600">@(p.Email ?? "—")</span>
                                        <span class="t2">@p.Phone</span>
                                    </div>
                                </td>
                                <td><span class="muted">@(p.City ?? "—")</span></td>
                                <td>
                                    <div style="display:flex;gap:6px;flex-wrap:wrap">
                                        @if (p.IsCustomer)
                                        {
                                            <StatusPill Text="@(T("partners.cliente"))" Tone="info" Plain />
                                        }
                                        @if (p.IsSupplier)
                                        {
                                            <StatusPill Text="@(T("partners.proveedor"))" Tone="accent" Plain />
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
                                        <StatusPill Text="@(p.IsActive ? T("partners.activo") : T("partners.inactivo"))" Tone="@(p.IsActive ? "good" : "neutral")" />
                                        @if (p.Pending)
                                        {
                                            <span class="tag" title="@(T("partners.guardado_en_este_equipo_se"))">@T("partners.por_enviar")</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Page="page.Page" PageSize="page.PageSize" Total="page.Total" Noun="@(T("partners.registros"))" OnPage="async p => { _page = p; await ReloadAsync(); }" />
        }
    }
</div>

@if (_form is { } f)
{
    <Modal Title="@(T("partners.nuevo_cliente_proveedor"))" Subtitle="@(T("partners.se_registra_en_el_hub"))" Error="@_error" OnClose="Close">
        <ChildContent>
            <div class="segmented">
                <button class="@(f.Kind == "Company" ? "on" : "")" @onclick="@(() => SetKind(f, "Company"))">@T("partners.empresa")</button>
                <button class="@(f.Kind == "Person" ? "on" : "")" @onclick="@(() => SetKind(f, "Person"))">@T("partners.persona")</button>
            </div>
            <div class="field">
                <label>@(f.Kind == "Company" ? T("partners.razon_social") : T("partners.nombre_completo"))</label>
                <input class="control" @bind="f.Name" />
            </div>
            <div class="form-row">
                <div class="field">
                    <label>@T("partners.documento")</label>
                    <select class="select" @bind="f.DocumentType">
                        <option value="">@T("partners.sin_documento")</option>
                        <option value="RUC">@T("partners.ruc")</option>
                        <option value="DNI">@T("partners.dni")</option>
                        <option value="CE">@T("partners.carne_de_extranjeria")</option>
                        <option value="PAS">@T("partners.pasaporte")</option>
                    </select>
                </div>
                <div class="field">
                    <label>@T("partners.numero")</label>
                    <input class="control" disabled="@(f.DocumentType == "")" inputmode="numeric"
                           placeholder="@(f.DocumentType switch { "RUC" => T("partners.11_digitos"), "DNI" => T("partners.8_digitos"), _ => "" })" @bind="f.DocumentNumber" />
                </div>
            </div>
            <div class="form-row three">
                <div class="field">
                    <label>@T("partners.correo")</label>
                    <input class="control" type="email" @bind="f.Email" />
                </div>
                <div class="field">
                    <label>@T("partners.telefono")</label>
                    <input class="control" type="tel" @bind="f.Phone" />
                </div>
                <div class="field">
                    <label>@T("partners.ciudad")</label>
                    <input class="control" @bind="f.City" />
                </div>
            </div>
            <div style="display:flex;gap:22px;flex-wrap:wrap">
                <label class="check"><input type="checkbox" @bind="f.IsCustomer" />@T("partners.es_cliente")</label>
                <label class="check"><input type="checkbox" @bind="f.IsSupplier" />@T("partners.es_proveedor")</label>
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="Close">@T("partners.cancelar")</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="SaveAsync">@T("partners.guardar")</button>
        </Footer>
    </Modal>
}

@code {
    private sealed class PartyForm
    {
        public string Kind { get; set; } = "Company";
        public string Name { get; set; } = "";
        public string DocumentType { get; set; } = "RUC";
        public string? DocumentNumber { get; set; }
        public string? Email { get; set; }
        public string? Phone { get; set; }
        public string? City { get; set; }
        public bool IsCustomer { get; set; } = true;
        public bool IsSupplier { get; set; }
    }

    private static (string Value, string Label)[] Tabs => [("", T("partners.todos")), ("customers", T("partners.clientes")), ("suppliers", T("partners.proveedores"))];

    private const int PageSize = 12;
    private PagedResult<PartyRow>? _result;
    private string _search = "", _tab = "";
    private int _page = 1;
    private CancellationTokenSource? _debounce;
    private PartyForm? _form;
    private string? _error;
    private bool _busy;

    protected override async Task LoadAsync()
    {
        bool? customers = _tab == "customers" ? true : null, suppliers = _tab == "suppliers" ? true : null;
        _result = await Wms.Master.GetPartiesAsync(_search, customers, suppliers, _page, PageSize);
        if (_result.Items.Count == 0 && _page > 1)
        {
            _page = _result.Pages;
            _result = await Wms.Master.GetPartiesAsync(_search, customers, suppliers, _page, PageSize);
        }
    }

    private async Task SetTabAsync(string tab)
    {
        _tab = tab;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(220, _debounce.Token);
            _page = 1;
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private static void SetKind(PartyForm f, string kind)
    {
        f.Kind = kind;
        f.DocumentType = kind == "Company" ? "RUC" : "DNI";
    }

    private void Open()
    {
        _error = null;
        _form = new PartyForm { IsSupplier = _tab == "suppliers", IsCustomer = _tab != "suppliers" };
    }

    private async Task SaveAsync()
    {
        if (_form is not { } f)
            return;
        var docType = f.DocumentType == "" ? null : f.DocumentType;
        var draft = new PartyDraft(f.Name, f.Kind, f.IsCustomer, f.IsSupplier, docType, docType is null ? null : f.DocumentNumber?.Trim(),
            f.Email, f.Phone, f.City);
        _busy = true;
        _error = await TryAsync(() => Wms.Master.CreatePartyAsync(draft), T("partners.registrado", f.Name.Trim()));
        _busy = false;
        if (_error is null)
            Close();
    }

    private void Close()
    {
        _form = null;
        _error = null;
    }

    public override void Dispose()
    {
        _debounce?.Cancel();
        base.Dispose();
    }
}
