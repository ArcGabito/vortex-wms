@inherits LayoutComponentBase
@implements IDisposable
@inject AppSession Session
@inject NavigationManager Nav
@inject BackButton Back
@inject IJSRuntime JS

@if (Session.IsSignedIn)
{
    <div class="app">
        <div class="sidebar-backdrop @(_menuOpen ? "open" : "")" @onclick="() => _menuOpen = false"></div>
        <aside class="sidebar @(_menuOpen ? "open" : "")">
            <div class="brand"><Logo /></div>
            <nav class="nav" @onclick="() => _menuOpen = false">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><Icon Name="home" />@T("nav.panel")</NavLink>
                <NavLink class="nav-link" href="inventario"><Icon Name="boxes" />@T("nav.inventario")</NavLink>
                <NavLink class="nav-link" href="recepciones">
                    <Icon Name="inbox" />@T("nav.recepciones")
                    @if (_receipts > 0)
                    {
                        <span class="count">@_receipts</span>
                    }
                </NavLink>
                <NavLink class="nav-link" href="pedidos">
                    <Icon Name="truck" />@T("nav.pedidos")
                    @if (_orders > 0)
                    {
                        <span class="count">@_orders</span>
                    }
                </NavLink>
                <NavLink class="nav-link" href="tareas">
                    <Icon Name="clipboard" />@T("nav.tareas")
                    @if (_tasks > 0)
                    {
                        <span class="count">@_tasks</span>
                    }
                </NavLink>
                <NavLink class="nav-link" href="movimientos"><Icon Name="arrows" />@T("nav.movimientos")</NavLink>
                <NavLink class="nav-link" href="guardado"><Icon Name="inbox" />@T("nav.guardar")</NavLink>
                <NavLink class="nav-link" href="reabastecer"><Icon Name="sync" />@T("nav.reabastecer")</NavLink>
                <NavLink class="nav-link" href="ubicaciones"><Icon Name="pin" />@T("nav.ubicaciones")</NavLink>
                <NavLink class="nav-link" href="lotes"><Icon Name="layers" />@T("nav.lotes")</NavLink>
                <NavLink class="nav-link" href="conteos"><Icon Name="clipboard" />@T("nav.conteos")</NavLink>

                <div class="nav-section">@T("nav.catalogo")</div>
                <NavLink class="nav-link" href="articulos"><Icon Name="tag" />@T("nav.articulos")</NavLink>
                <NavLink class="nav-link" href="sedes"><Icon Name="warehouse" />@T("nav.almacenes")</NavLink>
                <NavLink class="nav-link" href="socios"><Icon Name="users" />@T("nav.contactos")</NavLink>

                <div class="nav-section">@T("nav.sistema")</div>
                @if (Session.Can(WmsPermissions.ViewAudit))
                {
                    <NavLink class="nav-link" href="auditoria"><Icon Name="list" />@T("nav.auditoria")</NavLink>
                }
                <NavLink class="nav-link" href="configuracion"><Icon Name="settings" />@T("nav.configuracion")</NavLink>
            </nav>

            <div class="promo">
                <BoxArt Class="box-art" />
                <h4>@T("nav.libre_de_codigo_abierto")</h4>
                <p>@T("nav.vortex_wms_es_agpl_3")</p>
                <button class="btn btn-accent btn-sm" @onclick="OpenRepoAsync">@T("nav.contribuir")</button>
            </div>
        </aside>

        <div class="main">
            <TopBar OnMenu="() => _menuOpen = !_menuOpen" />
            <div class="content">
                <ErrorBoundary @ref="_boundary">
                    @Body
                </ErrorBoundary>
            </div>
        </div>
    </div>
}

@code {
    private bool _menuOpen;
    private int _orders, _receipts, _tasks;
    private ErrorBoundary? _boundary;
    private IDisposable? _back;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Session.DataChanged += OnDataChanged;
        Nav.LocationChanged += OnLocationChanged;
        _back = Back.Register(OnBack);
    }

    /// <summary>Atrás (Android): cierra el menú; fuera del panel vuelve a la página anterior; en el panel deja salir de la app.</summary>
    private bool OnBack()
    {
        if (_menuOpen)
        {
            _ = InvokeAsync(() => { _menuOpen = false; StateHasChanged(); });
            return true;
        }
        if (!Session.IsSignedIn || Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Length == 0)
            return false;
        _ = InvokeAsync(async () => await JS.InvokeVoidAsync("history.back"));
        return true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.IsSignedIn)
        {
            Nav.NavigateTo("login", replace: true);
            return;
        }
        await LoadCountsAsync();
    }

    private async Task LoadCountsAsync()
    {
        if (Session.Workspace is not { } wms)
            return;
        var summary = await wms.Inventory.GetDashboardAsync();
        _orders = summary.OrdersOpen;
        _receipts = summary.ReceiptsExpected;
        _tasks = await wms.Tasks.CountMineAsync();
    }

    private void OnSessionChanged() => _ = InvokeAsync(() =>
    {
        if (!Session.IsSignedIn)
            Nav.NavigateTo("login", replace: true);
        StateHasChanged();
    });

    private void OnDataChanged() => _ = InvokeAsync(async () =>
    {
        await LoadCountsAsync();
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _boundary?.Recover();

    private static Task OpenRepoAsync() => Launcher.Default.OpenAsync("https://github.com/ArcGabito/vortex-wms");

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Session.DataChanged -= OnDataChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _back?.Dispose();
    }
}
