@implements IDisposable
@inject AppSession Session
@inject NavigationManager Nav

<header class="topbar">
    <button class="btn btn-ghost icon-btn menu-btn" @onclick="OnMenu" aria-label="@(T("topbar.menu"))"><Icon Name="menu" /></button>
    <div class="page-title"><SectionOutlet SectionName="page-title" /></div>

    <form class="top-search" @onsubmit="Search" role="search">
        <Icon Name="search" Size="18" />
        <input placeholder="@(T("topbar.buscar_articulo_sku_codigo_de"))" @bind="_query" aria-label="@(T("topbar.buscar_en_el_inventario"))" />
    </form>

    <div class="spacer"></div>

    <button class="sync-chip @ChipClass" @onclick="Session.SyncNow" title="@(T("topbar.sincronizar_ahora"))">
        @if (Session.Sync.IsSyncing)
        {
            <span class="spinner sm"></span>
        }
        else
        {
            <span class="led"></span>
        }
        <span class="label">@ChipText</span>
    </button>

    <div class="menu-anchor">
        <button class="btn icon-btn round bell" @onclick="() => _panel = _panel == Panel.Alerts ? Panel.None : Panel.Alerts" aria-label="@(T("topbar.notificaciones"))">
            <Icon Name="bell" />
            @if (HasAlerts)
            {
                <span class="dot"></span>
            }
        </button>
        @if (_panel == Panel.Alerts)
        {
            <div class="menu-backdrop" @onclick="() => _panel = Panel.None"></div>
            <div class="popover">
                <h4 style="font-size:15px;margin-bottom:6px">@T("topbar.sincronizacion_con_el_hub")</h4>
                <div class="list-row">
                    <span class="pill @ConnectionTone">@ConnectionText</span>
                    <span class="end muted">@(Session.Sync.LastSyncAt is { } at ? T("topbar.ultima", Fmt.Ago(at)) : T("topbar.aun_sin_sincronizar"))</span>
                </div>
                <div class="list-row">
                    <Icon Name="sync" Size="18" Class="faint" />
                    <span>@T("topbar.operaciones_por_subir")</span>
                    <strong class="end">@Session.Sync.Pending</strong>
                </div>
                <div class="list-row">
                    <Icon Name="alert" Size="18" Class="faint" />
                    <span>@T("topbar.rechazadas_por_el_hub")</span>
                    <strong class="end @(Session.Sync.Failed > 0 ? "qty-neg" : "")">@Session.Sync.Failed</strong>
                </div>
                @if (Session.Sync.LastError is { } error)
                {
                    <div class="alert error" style="margin-top:10px">@error</div>
                }
                @if (Session.Connection == ConnectionState.Offline && Session.OfflineValidUntil is { } until)
                {
                    <div class="alert warn" style="margin-top:10px">@T("topbar.trabajando_sin_conexion_todo_se", Fmt.DateTime(until))</div>
                }
                <div style="display:flex;gap:8px;margin-top:14px">
                    <button class="btn btn-dark btn-sm" @onclick="SyncNow"><Icon Name="sync" Size="16" />@T("topbar.sincronizar_ahora")</button>
                    <button class="btn btn-sm" @onclick="GoToSettings">@T("topbar.ver_detalle")</button>
                </div>
            </div>
        }
    </div>

    <div class="menu-anchor">
        <button class="btn btn-ghost" style="padding:0;height:auto;border-radius:50%" @onclick="() => _panel = _panel == Panel.User ? Panel.None : Panel.User" aria-label="@(T("topbar.cuenta"))">
            <Avatar Text="@Session.UserName" Size="44" Class="user" />
        </button>
        @if (_panel == Panel.User)
        {
            <div class="menu-backdrop" @onclick="() => _panel = Panel.None"></div>
            <div class="menu" @onclick="() => _panel = Panel.None">
                <div style="padding:10px 12px 8px">
                    <div class="strong" style="font-weight:700">@Session.UserName</div>
                    <div class="muted" style="font-size:12px">@Session.Session?.User.Email</div>
                    <div class="faint" style="font-size:12px;margin-top:4px">@Session.Session?.Access.OrganizationName@(Session.Session?.Access.Role is { } role ? $" · {role}" : "")</div>
                </div>
                <hr />
                <a href="configuracion"><Icon Name="settings" Size="18" />@T("topbar.configuracion")</a>
                <button class="danger" @onclick="SignOutAsync"><Icon Name="logout" Size="18" />@T("topbar.cerrar_sesion")</button>
            </div>
        }
    </div>
</header>

@code {
    private enum Panel { None, Alerts, User }

    [Parameter] public EventCallback OnMenu { get; set; }

    private string _query = "";
    private Panel _panel;
    private Timer? _clock;

    private bool HasAlerts => Session.Sync.Failed > 0 || Session.Sync.LastError is not null || Session.Connection == ConnectionState.OfflineExpired;

    private string ChipClass => Session.Connection switch
    {
        ConnectionState.Online => "online",
        ConnectionState.Offline => "offline",
        ConnectionState.OfflineExpired => "expired",
        _ => "",
    };

    private string ChipText
    {
        get
        {
            var s = Session.Sync;
            if (s.IsSyncing)
                return T("topbar.sincronizando");
            var pending = s.Pending > 0 ? T("topbar.por_subir", s.Pending) : "";
            return Session.Connection switch
            {
                ConnectionState.Online => s.Pending > 0 ? T("topbar.en_linea_pendientes", pending) : s.LastSyncAt is { } at ? T("topbar.sincronizado", Fmt.Ago(at)) : T("topbar.en_linea"),
                ConnectionState.Offline => T("topbar.sin_conexion", pending),
                ConnectionState.OfflineExpired => T("topbar.conectate_para_seguir"),
                _ => T("topbar.conectando"),
            };
        }
    }

    private string ConnectionText => Session.Connection switch
    {
        ConnectionState.Online => T("topbar.en_linea"),
        ConnectionState.Offline => T("topbar.sin_conexion_2"),
        ConnectionState.OfflineExpired => T("topbar.periodo_sin_conexion_agotado"),
        _ => T("topbar.conectando_2"),
    };

    private string ConnectionTone => Session.Connection switch
    {
        ConnectionState.Online => "good",
        ConnectionState.Offline => "warn",
        ConnectionState.OfflineExpired => "bad",
        _ => "neutral",
    };

    protected override void OnInitialized()
    {
        Session.Changed += OnChanged;
        _clock = new Timer(_ => OnChanged(), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void Search()
    {
        var q = _query.Trim();
        _query = "";
        Nav.NavigateTo(string.IsNullOrEmpty(q) ? "inventario" : $"inventario?q={Uri.EscapeDataString(q)}");
    }

    private void SyncNow()
    {
        Session.SyncNow();
        _panel = Panel.None;
    }

    private void GoToSettings()
    {
        _panel = Panel.None;
        Nav.NavigateTo("configuracion");
    }

    private Task SignOutAsync() => Session.SignOutAsync();

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        _clock?.Dispose();
    }
}
