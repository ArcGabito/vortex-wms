@implements IDisposable
@inject AppSession Session
@inject NavigationManager Nav

<header class="topbar">
    <button class="btn btn-ghost icon-btn menu-btn" @onclick="OnMenu" aria-label="Menú"><Icon Name="menu" /></button>
    <div class="page-title"><SectionOutlet SectionName="page-title" /></div>

    <form class="top-search" @onsubmit="Search" role="search">
        <Icon Name="search" Size="18" />
        <input placeholder="Buscar artículo, SKU, código de barras…" @bind="_query" aria-label="Buscar en el inventario" />
    </form>

    <div class="spacer"></div>

    <button class="sync-chip @ChipClass" @onclick="Session.SyncNow" title="Sincronizar ahora">
        @if (Session.Sync.IsSyncing)
        {
            <span class="spinner sm"></span>
        }
        else
        {
            <span class="led"></span>
        }
        <span class="label">@ChipText</span>
    </button>

    <div class="menu-anchor">
        <button class="btn icon-btn round bell" @onclick="() => _panel = _panel == Panel.Alerts ? Panel.None : Panel.Alerts" aria-label="Notificaciones">
            <Icon Name="bell" />
            @if (HasAlerts)
            {
                <span class="dot"></span>
            }
        </button>
        @if (_panel == Panel.Alerts)
        {
            <div class="menu-backdrop" @onclick="() => _panel = Panel.None"></div>
            <div class="popover">
                <h4 style="font-size:15px;margin-bottom:6px">Sincronización con el hub</h4>
                <div class="list-row">
                    <span class="pill @ConnectionTone">@ConnectionText</span>
                    <span class="end muted">@(Session.Sync.LastSyncAt is { } at ? $"Última: {Fmt.Ago(at)}" : "Aún sin sincronizar")</span>
                </div>
                <div class="list-row">
                    <Icon Name="sync" Size="18" Class="faint" />
                    <span>Operaciones por subir</span>
                    <strong class="end">@Session.Sync.Pending</strong>
                </div>
                <div class="list-row">
                    <Icon Name="alert" Size="18" Class="faint" />
                    <span>Rechazadas por el hub</span>
                    <strong class="end @(Session.Sync.Failed > 0 ? "qty-neg" : "")">@Session.Sync.Failed</strong>
                </div>
                @if (Session.Sync.LastError is { } error)
                {
                    <div class="alert error" style="margin-top:10px">@error</div>
                }
                @if (Session.Connection == ConnectionState.Offline && Session.OfflineValidUntil is { } until)
                {
                    <div class="alert warn" style="margin-top:10px">Trabajando sin conexión. Todo se guarda en este equipo y se sube al reconectar (acceso sin conexión hasta el @Fmt.DateTime(until)).</div>
                }
                <div style="display:flex;gap:8px;margin-top:14px">
                    <button class="btn btn-dark btn-sm" @onclick="SyncNow"><Icon Name="sync" Size="16" />Sincronizar ahora</button>
                    <button class="btn btn-sm" @onclick="GoToSettings">Ver detalle</button>
                </div>
            </div>
        }
    </div>

    <div class="menu-anchor">
        <button class="btn btn-ghost" style="padding:0;height:auto;border-radius:50%" @onclick="() => _panel = _panel == Panel.User ? Panel.None : Panel.User" aria-label="Cuenta">
            <Avatar Text="@Session.UserName" Size="44" Class="user" />
        </button>
        @if (_panel == Panel.User)
        {
            <div class="menu-backdrop" @onclick="() => _panel = Panel.None"></div>
            <div class="menu" @onclick="() => _panel = Panel.None">
                <div style="padding:10px 12px 8px">
                    <div class="strong" style="font-weight:700">@Session.UserName</div>
                    <div class="muted" style="font-size:12px">@Session.Session?.User.Email</div>
                    <div class="faint" style="font-size:12px;margin-top:4px">@Session.Session?.Access.OrganizationName@(Session.Session?.Access.Role is { } role ? $" · {role}" : "")</div>
                </div>
                <hr />
                <a href="configuracion"><Icon Name="settings" Size="18" />Configuración</a>
                <button class="danger" @onclick="SignOutAsync"><Icon Name="logout" Size="18" />Cerrar sesión</button>
            </div>
        }
    </div>
</header>

@code {
    private enum Panel { None, Alerts, User }

    [Parameter] public EventCallback OnMenu { get; set; }

    private string _query = "";
    private Panel _panel;
    private Timer? _clock;

    private bool HasAlerts => Session.Sync.Failed > 0 || Session.Sync.LastError is not null || Session.Connection == ConnectionState.OfflineExpired;

    private string ChipClass => Session.Connection switch
    {
        ConnectionState.Online => "online",
        ConnectionState.Offline => "offline",
        ConnectionState.OfflineExpired => "expired",
        _ => "",
    };

    private string ChipText
    {
        get
        {
            var s = Session.Sync;
            if (s.IsSyncing)
                return "Sincronizando…";
            var pending = s.Pending > 0 ? $" · {s.Pending} por subir" : "";
            return Session.Connection switch
            {
                ConnectionState.Online => s.Pending > 0 ? $"En línea{pending}" : s.LastSyncAt is { } at ? $"Sincronizado {Fmt.Ago(at)}" : "En línea",
                ConnectionState.Offline => $"Sin conexión{pending}",
                ConnectionState.OfflineExpired => "Conéctate para seguir",
                _ => "Conectando…",
            };
        }
    }

    private string ConnectionText => Session.Connection switch
    {
        ConnectionState.Online => "En línea",
        ConnectionState.Offline => "Sin conexión",
        ConnectionState.OfflineExpired => "Periodo sin conexión agotado",
        _ => "Conectando",
    };

    private string ConnectionTone => Session.Connection switch
    {
        ConnectionState.Online => "good",
        ConnectionState.Offline => "warn",
        ConnectionState.OfflineExpired => "bad",
        _ => "neutral",
    };

    protected override void OnInitialized()
    {
        Session.Changed += OnChanged;
        _clock = new Timer(_ => OnChanged(), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void Search()
    {
        var q = _query.Trim();
        _query = "";
        Nav.NavigateTo(string.IsNullOrEmpty(q) ? "inventario" : $"inventario?q={Uri.EscapeDataString(q)}");
    }

    private void SyncNow()
    {
        Session.SyncNow();
        _panel = Panel.None;
    }

    private void GoToSettings()
    {
        _panel = Panel.None;
        Nav.NavigateTo("configuracion");
    }

    private Task SignOutAsync() => Session.SignOutAsync();

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        _clock?.Dispose();
    }
}
