@implements IDisposable
@inject AppSession Session
@inject IJSRuntime JS
@*
    Buscador de artículos por SKU, nombre o código de barras. Funciona con lectores de código de barras que escriben
    el código y envían Enter: si hay una coincidencia exacta, la elige sola. Si el código es el de una presentación
    (DUN-14 de la caja), avisa también la presentación en OnPicked.
*@
<div class="picker">
    <div class="input-icon" @ref="_anchor">
        <Icon Name="barcode" Size="18" />
        <input @ref="_input" class="control" placeholder="@Placeholder" value="@_term" autocomplete="off"
               @oninput="OnInput" @onkeydown="OnKeyAsync" @onfocus="OnFocusAsync" @onblur="OnBlur" />
    </div>
    @if (_open && _results.Count > 0)
    {
        <div class="picker-list" style="@_style">
            @for (var i = 0; i < _results.Count; i++)
            {
                var item = _results[i];
                <button class="@(i == _highlight ? "hl" : "")" @onmousedown="() => SelectAsync(item)" @onmousedown:preventDefault>
                    <Avatar Text="@item.Name" Size="32" />
                    <span class="two-line">
                        <span class="t1">@item.Name</span>
                        <span class="t2">#@item.Sku@(item.Barcode is null ? "" : $" · {item.Barcode}") · @Fmt.Qty(item.OnHand) @item.Unit</span>
                    </span>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Placeholder { get; set; } = T("itempicker.escanea_busca_por_sku_nombre");
    [Parameter] public EventCallback<ItemRow> OnSelected { get; set; }

    /// <summary>Como OnSelected, pero con la presentación escaneada (null = unidad base).</summary>
    [Parameter] public EventCallback<ItemScan> OnPicked { get; set; }

    private ElementReference _anchor, _input;
    private string _term = "";
    private bool _open;
    private int _highlight;
    private string _style = "";
    private List<ItemRow> _results = [];
    private CancellationTokenSource? _debounce;

    private async Task OnInput(ChangeEventArgs e)
    {
        _term = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(140, token);
            await SearchAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task SearchAsync()
    {
        if (Session.Workspace is not { } wms)
            return;
        _results = string.IsNullOrWhiteSpace(_term) ? [] : (await wms.Master.SearchItemsAsync(_term, 8)).Where(i => i.TrackInventory).ToList();
        _highlight = 0;
        await PositionAsync();
        _open = true;
    }

    private async Task OnKeyAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
                _highlight = Math.Min(_highlight + 1, _results.Count - 1);
                break;
            case "ArrowUp":
                _highlight = Math.Max(_highlight - 1, 0);
                break;
            case "Escape":
                _open = false;
                break;
            case "Enter":
                _debounce?.Cancel();
                await SearchAsync();
                if (Session.Workspace is { } wms && await wms.Master.ScanAsync(_term) is { Item.TrackInventory: true } scan)
                {
                    await SelectAsync(scan.Item, scan.Presentation);
                    break;
                }
                var pick = _results.Count == 1 ? _results[0] : _open && _highlight < _results.Count ? _results[_highlight] : null;
                if (pick is not null)
                    await SelectAsync(pick);
                break;
        }
    }

    private async Task SelectAsync(ItemRow item, ItemPresentation? presentation = null)
    {
        _term = "";
        _results = [];
        _open = false;
        await OnSelected.InvokeAsync(item);
        await OnPicked.InvokeAsync(new ItemScan(item, presentation));
        await JS.InvokeVoidAsync("vortex.focus", _input);
    }

    private async Task OnFocusAsync()
    {
        if (_results.Count > 0)
        {
            await PositionAsync();
            _open = true;
        }
    }

    private void OnBlur() => _open = false;

    private async Task PositionAsync()
    {
        var r = await JS.InvokeAsync<double[]>("vortex.rect", _anchor);
        _style = FormattableString.Invariant($"position:fixed;top:{r[2] + 6:0}px;left:{r[1]:0}px;width:{r[3] - r[1]:0}px;right:auto");
    }

    public void Dispose() => _debounce?.Cancel();
}
