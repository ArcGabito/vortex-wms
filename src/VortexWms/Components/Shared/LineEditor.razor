@*
    Líneas de un documento (recepción, transferencia, pedido): se agregan escaneando o buscando el artículo. Cada
    línea puede ir en una presentación (2 cajas × 12); al documento llega siempre en la unidad base (24).
*@
<div class="lines">
    <ItemPicker OnPicked="AddAsync" />
    @if (Lines.Count > 0)
    {
        <div class="line @(ShowPrice ? "with-price" : "")" style="background:transparent;padding-top:0;padding-bottom:0">
            <span class="field-label">@T("lineeditor.articulo")</span>
            @if (ShowPrice)
            {
                <span class="field-label">@PriceLabel</span>
            }
            <span class="field-label">@T("lineeditor.cantidad")</span>
            <span></span>
        </div>
    }
    @foreach (var line in Lines)
    {
        <div class="line @(ShowPrice ? "with-price" : "")" @key="line">
            <div class="cell-main">
                <Avatar Text="@line.Item.Name" Size="34" />
                <div class="two-line">
                    <span class="t1">@line.Item.Name</span>
                    <span class="t2">
                        #@line.Item.Sku · @line.Item.Unit
                        @if (line.Item.Presentations.Count > 0)
                        {
                            <select class="select inline" value="@(line.Presentation ?? "")" aria-label="@(T("lineeditor.presentacion"))"
                                    @onchange="e => ChangePresentationAsync(line, e.Value?.ToString())">
                                <option value="">@line.Item.Unit</option>
                                @foreach (var p in line.Item.Presentations)
                                {
                                    <option value="@p.Code">@p.Name</option>
                                }
                            </select>
                            @if (line.Presentation is not null)
                            {
                                <span> = @Fmt.Qty(line.BaseQuantity) @line.Item.Unit</span>
                            }
                        }
                        @if (line.Available is { } available)
                        {
                            <span class="@(available < line.BaseQuantity ? "warn-text" : "")"> @T("lineeditor.disponible", Fmt.Qty(available))</span>
                        }
                    </span>
                </div>
            </div>
            @if (ShowPrice)
            {
                <input class="control" type="number" min="0" step="0.01" @bind="line.Price" @bind:event="oninput" @bind:after="NotifyAsync" aria-label="@PriceLabel" />
            }
            <input class="control" type="number" min="0" step="any" @bind="line.Quantity" @bind:event="oninput" @bind:after="NotifyAsync" aria-label="@(T("lineeditor.cantidad"))" />
            <button class="btn btn-ghost icon-btn sm" @onclick="() => RemoveAsync(line)" aria-label="@(T("lineeditor.quitar"))"><Icon Name="x" Size="16" /></button>
        </div>
    }
</div>

@code {
    public sealed class LineDraft
    {
        public required ItemRow Item { get; init; }
        public decimal Quantity { get; set; } = 1;
        public decimal? Price { get; set; }
        public decimal? Available { get; set; }

        /// <summary>Código de la presentación en que se ingresan cantidad y precio (null = unidad base).</summary>
        public string? Presentation { get; set; }

        public decimal BaseQuantity => Item.ToBase(Presentation, Quantity).Quantity;

        public DocumentLine ToDocumentLine()
        {
            var (quantity, price) = Item.ToBase(Presentation, Quantity, Price);
            return new(Item.Id, quantity, price);
        }
    }

    [Parameter, EditorRequired] public List<LineDraft> Lines { get; set; } = [];
    [Parameter] public bool ShowPrice { get; set; }
    [Parameter] public string PriceLabel { get; set; } = T("lineeditor.precio");

    /// <summary>Precio inicial de una línea nueva (p. ej. el precio del artículo).</summary>
    [Parameter] public Func<ItemRow, decimal?>? DefaultPrice { get; set; }

    /// <summary>Disponible del artículo en la sede de origen, para avisar si no alcanza.</summary>
    [Parameter] public Func<ItemRow, Task<decimal?>>? AvailableFor { get; set; }

    /// <summary>Se avisa al agregar, quitar o editar una línea, para que el formulario recalcule totales y botones.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private async Task AddAsync(ItemScan scan)
    {
        var (item, presentation) = (scan.Item, scan.Presentation?.Code);
        if (Lines.FirstOrDefault(l => l.Item.Id == item.Id && l.Presentation == presentation) is { } existing)
        {
            existing.Quantity += 1;
        }
        else
        {
            var price = DefaultPrice?.Invoke(item);
            Lines.Add(new LineDraft
            {
                Item = item,
                Presentation = presentation,
                Price = price is { } p && scan.Presentation is { } pres ? p * pres.Factor : price,
                Available = AvailableFor is null ? null : await AvailableFor(item),
            });
        }
        await NotifyAsync();
    }

    /// <summary>Cambia la presentación de la línea manteniendo el precio por unidad base.</summary>
    private Task ChangePresentationAsync(LineDraft line, string? code)
    {
        var next = string.IsNullOrEmpty(code) ? null : code;
        var oldFactor = line.Item.PresentationByCode(line.Presentation)?.Factor ?? 1;
        var newFactor = line.Item.PresentationByCode(next)?.Factor ?? 1;
        if (line.Price is { } price)
            line.Price = decimal.Round(price / oldFactor * newFactor, 4);
        line.Presentation = next;
        return NotifyAsync();
    }

    private Task RemoveAsync(LineDraft line)
    {
        Lines.Remove(line);
        return NotifyAsync();
    }

    private Task NotifyAsync() => Changed.InvokeAsync();

    /// <summary>Recalcula el disponible de todas las líneas (al cambiar la sede de origen).</summary>
    public async Task RefreshAvailabilityAsync()
    {
        if (AvailableFor is null)
            return;
        foreach (var line in Lines)
            line.Available = await AvailableFor(line.Item);
        StateHasChanged();
    }
}
