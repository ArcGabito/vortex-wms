@implements IDisposable
@inject Toasts Toasts

<div class="toasts" role="status" aria-live="polite">
    @foreach (var t in Toasts.Items)
    {
        <div class="toast @t.Kind.ToString().ToLowerInvariant()" @key="t.Id">
            <span class="ic"><Icon Name="@(t.Kind == ToastKind.Error ? "x" : t.Kind == ToastKind.Success ? "check" : "bell")" Size="13" Stroke="2.6" /></span>
            <span>@t.Message</span>
            <button @onclick="() => Toasts.Dismiss(t.Id)" aria-label="@(T("toasthost.cerrar"))"><Icon Name="x" Size="16" /></button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Toasts.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Toasts.Changed -= OnChanged;
}
