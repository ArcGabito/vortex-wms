<?xml version="1.0" encoding="utf-8"?>
<!--
  El SDK del hub (VortexApi.Client) se toma del feed local packages/vortex-sdk, que se llena con
  scripts/pack-sdk.ps1 (Windows + WSL) o scripts/pack-sdk.sh (Linux/macOS) desde el repo ArcGabito/vortex-api.
  Todo lo demás viene de nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="vortex-local" value="packages/vortex-sdk" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="vortex-local">
      <package pattern="VortexApi.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
